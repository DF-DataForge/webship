msgstr "Bepaal hoe leveringsorders en inkooporders worden gesynchroniseerd met Stoqflow."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Default Statuses"
msgstr "Standaard statussen"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Choose the initial status for new orders and purchase orders when they are created in Stoqflow."
msgstr "Kies de initiële status voor nieuwe orders en inkooporders wanneer ze in Stoqflow worden aangemaakt."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Brand & Shop"
msgstr "Merk & Winkel"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Select the default brand and shop assigned to orders sent to Stoqflow. These must be loaded first using the button below."
msgstr "Selecteer het standaard merk en de winkel die worden toegewezen aan orders die naar Stoqflow worden gestuurd. Deze moeten eerst worden geladen met de onderstaande knop."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Load companies / brands / warehouses"
msgstr "Laad bedrijven / merken / magazijnen"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Companies, brands, and warehouses need to be loaded from the Stoqflow API before orders can be processed."
msgstr "Bedrijven, merken en magazijnen moeten worden geladen vanuit de Stoqflow API voordat orders kunnen worden verwerkt."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Domain Filter"
msgstr "Domeinfilter"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Optionally restrict which pickings are automatically synced to Stoqflow using an Odoo domain expression."
msgstr "Beperk optioneel welke pickings automatisch naar Stoqflow worden gesynchroniseerd met een Odoo-domeinexpressie."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Only pickings matching this filter will be synced. Leave empty to sync all Stoqflow pickings."
msgstr "Alleen pickings die aan dit filter voldoen worden gesynchroniseerd. Laat leeg om alle Stoqflow-pickings te synchroniseren."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Logging & Display"
msgstr "Logging & Weergave"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Configure extra UI elements and API logging for debugging."
msgstr "Configureer extra UI-elementen en API-logging voor foutopsporing."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Synchronization"
msgstr "Synchronisatie"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Manual Actions"
msgstr "Handmatige acties"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Trigger synchronization actions manually. These are also run automatically by the scheduled cron jobs."
msgstr "Synchronisatieacties handmatig starten. Deze worden ook automatisch uitgevoerd door de geplande cron jobs."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Import stock from Stoqflow"
msgstr "Voorraad importeren uit Stoqflow"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Fetch current stock levels from the Stoqflow API and update Odoo quants."
msgstr "Huidige voorraadniveaus ophalen via de Stoqflow API en Odoo-quants bijwerken."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Process pending orders"
msgstr "Openstaande orders verwerken"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Push all pickings with status 'Pending' to the Stoqflow API."
msgstr "Alle pickings met status 'In afwachting' naar de Stoqflow API sturen."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Fetch order info"
msgstr "Orderinfo ophalen"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Retrieve the latest quantities and statuses from Stoqflow for all open pickings."
msgstr "De laatste hoeveelheden en statussen ophalen uit Stoqflow voor alle openstaande pickings."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Last Check Timestamps"
msgstr "Laatste controletijdstippen"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Shows when the cron jobs last fetched status updates from Stoqflow."
msgstr "Toont wanneer de cron jobs voor het laatst statusupdates uit Stoqflow hebben opgehaald."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_sync_order
msgid "When enabled, new delivery orders are automatically marked for synchronization with Stoqflow (process code 'P'). The cron job will then push them to the Stoqflow API."
msgstr "Indien ingeschakeld worden nieuwe leveringsorders automatisch gemarkeerd voor synchronisatie met Stoqflow (procescode 'P'). De cron job stuurt ze vervolgens naar de Stoqflow API."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_auto_create_backorder
msgid "When enabled, a backorder is automatically created in Odoo when Stoqflow reports an order as completed with partial quantities."
msgstr "Indien ingeschakeld wordt automatisch een nalevering aangemaakt in Odoo wanneer Stoqflow een order meldt als afgerond met gedeeltelijke hoeveelheden."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_log_json
msgid "When enabled, every JSON payload sent to and received from the Stoqflow API is saved in the JSON History log. Useful for debugging synchronization issues."
msgstr "Indien ingeschakeld wordt elke JSON-payload die naar de Stoqflow API wordt gestuurd of ontvangen opgeslagen in het JSON-geschiedenislogboek. Handig voor het oplossen van synchronisatieproblemen."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_show_parcels_tab
msgid "When enabled, a 'Stoqflow Parcels' tab is shown on the picking form view displaying parcel details (tracking numbers, dimensions, shipping info) fetched from Stoqflow."
msgstr "Indien ingeschakeld wordt een 'Stoqflow Pakketten'-tabblad getoond op het pickingformulier met pakketdetails (trackingnummers, afmetingen, verzendinformatie) opgehaald uit Stoqflow."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_default_brand
msgid "The brand assigned to orders sent to Stoqflow. Brands are loaded from the Stoqflow API using the 'Load companies/brands/warehouses' button."
msgstr "Het merk dat wordt toegewezen aan orders die naar Stoqflow worden gestuurd. Merken worden geladen via de Stoqflow API met de knop 'Laad bedrijven / merken / magazijnen'."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_default_shop
msgid "The shop assigned to orders sent to Stoqflow. Shops belong to a brand and are loaded from the Stoqflow API using the 'Load companies/brands/warehouses' button."
msgstr "De winkel die wordt toegewezen aan orders die naar Stoqflow worden gestuurd. Winkels behoren tot een merk en worden geladen via de Stoqflow API met de knop 'Laad bedrijven / merken / magazijnen'."

