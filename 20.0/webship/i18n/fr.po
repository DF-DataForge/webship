#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Enter the API key and secret from your Stoqflow account to authenticate with the Stoqflow REST API."
msgstr "Saisissez la cl\u00e9 API et le secret de votre compte Stoqflow pour vous authentifier aupr\u00e8s de l'API REST Stoqflow."

#. module: webship
