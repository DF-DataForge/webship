msgid "Test connection"
msgstr "Tester la connexion"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "General Settings"
msgstr "Param\u00e8tres g\u00e9n\u00e9raux"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Order Sync"
msgstr "Synchronisation des commandes"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Control how delivery orders and purchase orders are synchronized with Stoqflow."
msgstr "Contr\u00f4lez comment les ordres de livraison et les bons de commande sont synchronis\u00e9s avec Stoqflow."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Default Statuses"
msgstr "Statuts par d\u00e9faut"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Choose the initial status for new orders and purchase orders when they are created in Stoqflow."
msgstr "Choisissez le statut initial des nouvelles commandes et bons de commande lors de leur cr\u00e9ation dans Stoqflow."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Brand & Shop"
msgstr "Marque & Boutique"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Select the default brand and shop assigned to orders sent to Stoqflow. These must be loaded first using the button below."
msgstr "S\u00e9lectionnez la marque et la boutique par d\u00e9faut attribu\u00e9es aux commandes envoy\u00e9es \u00e0 Stoqflow. Elles doivent d'abord \u00eatre charg\u00e9es \u00e0 l'aide du bouton ci-dessous."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Load companies / brands / warehouses"
msgstr "Charger les soci\u00e9t\u00e9s / marques / entrep\u00f4ts"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Companies, brands, and warehouses need to be loaded from the Stoqflow API before orders can be processed."
msgstr "Les soci\u00e9t\u00e9s, marques et entrep\u00f4ts doivent \u00eatre charg\u00e9s depuis l'API Stoqflow avant de pouvoir traiter les commandes."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Domain Filter"
msgstr "Filtre de domaine"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Optionally restrict which pickings are automatically synced to Stoqflow using an Odoo domain expression."
msgstr "Restreignez optionnellement quels pickings sont automatiquement synchronis\u00e9s avec Stoqflow en utilisant une expression de domaine Odoo."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Only pickings matching this filter will be synced. Leave empty to sync all Stoqflow pickings."
msgstr "Seuls les pickings correspondant \u00e0 ce filtre seront synchronis\u00e9s. Laissez vide pour synchroniser tous les pickings Stoqflow."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Logging & Display"
msgstr "Journalisation & Affichage"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Configure extra UI elements and API logging for debugging."
msgstr "Configurez les \u00e9l\u00e9ments d'interface suppl\u00e9mentaires et la journalisation API pour le d\u00e9bogage."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Synchronization"
msgstr "Synchronisation"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Manual Actions"
msgstr "Actions manuelles"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Trigger synchronization actions manually. These are also run automatically by the scheduled cron jobs."
msgstr "D\u00e9clenchez les actions de synchronisation manuellement. Elles sont \u00e9galement ex\u00e9cut\u00e9es automatiquement par les t\u00e2ches cron planifi\u00e9es."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Import stock from Stoqflow"
msgstr "Importer le stock depuis Stoqflow"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Fetch current stock levels from the Stoqflow API and update Odoo quants."
msgstr "R\u00e9cup\u00e9rer les niveaux de stock actuels depuis l'API Stoqflow et mettre \u00e0 jour les quants Odoo."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Process pending orders"
msgstr "Traiter les commandes en attente"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Push all pickings with status 'Pending' to the Stoqflow API."
msgstr "Envoyer tous les pickings avec le statut 'En attente' vers l'API Stoqflow."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Fetch order info"
msgstr "R\u00e9cup\u00e9rer les infos commande"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Retrieve the latest quantities and statuses from Stoqflow for all open pickings."
msgstr "R\u00e9cup\u00e9rer les derni\u00e8res quantit\u00e9s et statuts depuis Stoqflow pour tous les pickings ouverts."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Last Check Timestamps"
msgstr "Horodatages des derni\u00e8res v\u00e9rifications"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "Shows when the cron jobs last fetched status updates from Stoqflow."
msgstr "Indique quand les t\u00e2ches cron ont r\u00e9cup\u00e9r\u00e9 pour la derni\u00e8re fois les mises \u00e0 jour de statut depuis Stoqflow."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_sync_order
msgid "When enabled, new delivery orders are automatically marked for synchronization with Stoqflow (process code 'P'). The cron job will then push them to the Stoqflow API."
msgstr "Lorsque cette option est activ\u00e9e, les nouveaux ordres de livraison sont automatiquement marqu\u00e9s pour synchronisation avec Stoqflow (code processus 'P'). La t\u00e2che cron les enverra ensuite \u00e0 l'API Stoqflow."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_auto_create_backorder
msgid "When enabled, a backorder is automatically created in Odoo when Stoqflow reports an order as completed with partial quantities."
msgstr "Lorsque cette option est activ\u00e9e, un reliquat est automatiquement cr\u00e9\u00e9 dans Odoo lorsque Stoqflow signale une commande comme termin\u00e9e avec des quantit\u00e9s partielles."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_log_json
msgid "When enabled, every JSON payload sent to and received from the Stoqflow API is saved in the JSON History log. Useful for debugging synchronization issues."
msgstr "Lorsque cette option est activ\u00e9e, chaque charge utile JSON envoy\u00e9e et re\u00e7ue de l'API Stoqflow est enregistr\u00e9e dans le journal d'historique JSON. Utile pour d\u00e9boguer les probl\u00e8mes de synchronisation."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_show_parcels_tab
msgid "When enabled, a 'Stoqflow Parcels' tab is shown on the picking form view displaying parcel details (tracking numbers, dimensions, shipping info) fetched from Stoqflow."
msgstr "Lorsque cette option est activ\u00e9e, un onglet 'Colis Stoqflow' est affich\u00e9 sur la vue formulaire du picking, montrant les d\u00e9tails des colis (num\u00e9ros de suivi, dimensions, informations d'exp\u00e9dition) r\u00e9cup\u00e9r\u00e9s depuis Stoqflow."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_default_brand
msgid "The brand assigned to orders sent to Stoqflow. Brands are loaded from the Stoqflow API using the 'Load companies/brands/warehouses' button."
msgstr "La marque attribu\u00e9e aux commandes envoy\u00e9es \u00e0 Stoqflow. Les marques sont charg\u00e9es depuis l'API Stoqflow \u00e0 l'aide du bouton 'Charger les soci\u00e9t\u00e9s / marques / entrep\u00f4ts'."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_default_shop
msgid "The shop assigned to orders sent to Stoqflow. Shops belong to a brand and are loaded from the Stoqflow API using the 'Load companies/brands/warehouses' button."
msgstr "La boutique attribu\u00e9e aux commandes envoy\u00e9es \u00e0 Stoqflow. Les boutiques appartiennent \u00e0 une marque et sont charg\u00e9es depuis l'API Stoqflow \u00e0 l'aide du bouton 'Charger les soci\u00e9t\u00e9s / marques / entrep\u00f4ts'."

