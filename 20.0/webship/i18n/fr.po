#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<span class=\"text-muted ms-2\">Fetch only the orders and purchase orders "
"changed in Stoqflow since the last check (edited_after) and update the "
"matched pickings. Also run automatically by the 'Stoqflow fetch changed "
"orders' cron job when incremental status updates are enabled.</span>"
msgstr ""
"<span class=\"text-muted ms-2\">Ne récupère que les commandes et bons de "
"commande modifiés dans Stoqflow depuis la dernière vérification "
"(edited_after) et met à jour les transferts correspondants. Également "
"exécuté automatiquement par l'action planifiée « Stoqflow fetch changed "
"orders » lorsque les mises à jour de statut incrémentales sont "
"activées.</span>"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<span class=\"text-muted ms-2\">Fetches orders and purchase orders created "
"since the pointers and stores those with a parent_order_id as backorders. "
"The pointers advance to 'now' on success.</span>"
msgstr ""
"<span class=\"text-muted ms-2\">Récupère les commandes et bons de commande "
"créés depuis les pointeurs et enregistre ceux qui ont un parent_order_id "
"comme reliquats. Les pointeurs avancent à « maintenant » en cas de "
"succès.</span>"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<span class=\"text-muted ms-2\">Manually fetch stock levels from the "
"Stoqflow warehouse. This is also run automatically by the scheduled cron "
"job.</span>"
msgstr ""
"<span class=\"text-muted ms-2\">Récupère manuellement les niveaux de stock "
"de l'entrepôt Stoqflow. Ceci est également exécuté automatiquement par "
"l'action planifiée.</span>"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<span class=\"text-muted ms-2\">Push all pickings with status 'Pending' to "
"the Stoqflow API.</span>"
msgstr ""
"<span class=\"text-muted ms-2\">Envoie tous les transferts avec le statut « "
"En attente » vers l'API Stoqflow.</span>"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<span class=\"text-muted ms-2\">Retrieve the latest quantities and statuses "
"from Stoqflow for all open pickings.</span>"
msgstr ""
"<span class=\"text-muted ms-2\">Récupère les dernières quantités et statuts "
"de Stoqflow pour tous les transferts ouverts.</span>"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<span class=\"text-muted ms-2\">Scans all purchase orders for retours and "
"creates return pickings in Odoo.</span>"
msgstr ""
"<span class=\"text-muted ms-2\">Parcourt tous les bons de commande à la "
"recherche de retours et crée les transferts de retour dans Odoo.</span>"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<span class=\"text-muted ms-2\">Send the report immediately for the last 24 "
"hours.</span>"
msgstr ""
"<span class=\"text-muted ms-2\">Envoyer le rapport immédiatement pour les "
"dernières 24 heures.</span>"

