#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "<strong>E-mail only:</strong> Only looks up clients by e-mail address."
msgstr ""
"<strong>E-mail uniquement :</strong> Recherche les clients uniquement par "
"adresse e-mail."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<strong>E-mail only:</strong> Only looks up suppliers by e-mail address."
msgstr ""
"<strong>E-mail uniquement :</strong> Recherche les fournisseurs uniquement "
"par adresse e-mail."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<strong>E-mail → VAT:</strong> First looks up a client with the same e-mail "
"address. If no match is found, it tries the VAT number."
msgstr ""
"<strong>E-mail → TVA :</strong> Recherche d'abord un client ayant la même "
"adresse e-mail ; si aucune correspondance n'est trouvée, essaie le numéro de"
" TVA."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<strong>E-mail → VAT:</strong> First looks up a supplier with the same "
"e-mail address. If no match is found, it tries the VAT number."
msgstr ""
"<strong>E-mail → TVA :</strong> Recherche d'abord un fournisseur ayant la "
"même adresse e-mail ; si aucune correspondance n'est trouvée, essaie le "
"numéro de TVA."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<strong>Leave blank:</strong> Matching is skipped. A new Stoqflow client is "
"created whenever the Odoo partner has no df_client_id_webship yet."
msgstr ""
"<strong>Laisser vide :</strong> La correspondance est ignorée. Un nouveau "
"client Stoqflow est créé chaque fois que le partenaire Odoo n'a pas encore "
"de df_client_id_webship."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<strong>Leave blank:</strong> Matching is skipped. A new Stoqflow supplier "
"is created whenever the Odoo partner has no df_supplier_id_webship yet."
msgstr ""
"<strong>Laisser vide :</strong> La correspondance est ignorée. Un nouveau "
"fournisseur Stoqflow est créé chaque fois que le partenaire Odoo n'a pas "
"encore de df_supplier_id_webship."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "<strong>Run every</strong>"
msgstr "<strong>Exécuter tous les</strong>"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "<strong>Task</strong>"
msgstr "<strong>Tâche</strong>"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "<strong>Users</strong>"
msgstr "<strong>Utilisateurs</strong>"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<strong>VAT only:</strong> Only looks up clients by VAT number. Contacts "
"without a VAT number will not be matched."
msgstr ""
"<strong>TVA uniquement :</strong> Recherche les clients uniquement par "
"numéro de TVA. Les contacts sans numéro de TVA ne seront pas mis en "
"correspondance."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<strong>VAT only:</strong> Only looks up suppliers by VAT number. Partners "
"without a VAT number will not be matched."
msgstr ""
"<strong>TVA uniquement :</strong> Recherche les fournisseurs uniquement par "
"numéro de TVA. Les partenaires sans numéro de TVA ne seront pas mis en "
"correspondance."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<strong>VAT → E-mail:</strong> First looks up a client with the same VAT "
"number. If no match is found, it tries the e-mail address."
msgstr ""
"<strong>TVA → E-mail :</strong> Recherche d'abord un client ayant le même "
"numéro de TVA ; si aucune correspondance n'est trouvée, essaie l'adresse "
"e-mail."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<strong>VAT → E-mail:</strong> First looks up a supplier with the same VAT "
"number. If no match is found, it tries the e-mail address."
msgstr ""
"<strong>TVA → E-mail :</strong> Recherche d'abord un fournisseur ayant le "
"même numéro de TVA ; si aucune correspondance n'est trouvée, essaie "
"l'adresse e-mail."

