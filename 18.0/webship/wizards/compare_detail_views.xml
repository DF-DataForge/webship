<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="webship_compare_detail_form" model="ir.ui.view">
        <field name="name">webship.compare.detail.form</field>
        <field name="model">webship.compare.detail</field>
        <field name="arch" type="xml">
            <form string="Compare with Stoqflow">
                <group>
                    <field name="picking_id" readonly="1" options="{'no_open': True}"/>
                    <field name="order_found" readonly="1"/>
                    <field name="message" readonly="1" invisible="not message"/>
                </group>
                <field name="line_ids" nolabel="1" invisible="not order_found">
                    <list create="false" delete="false" edit="false"
                          decoration-success="status == 'match'"
                          decoration-danger="status in ('mismatch', 'missing_in_stoqflow', 'missing_in_odoo')"
                          decoration-warning="status == 'unresolved'">
                        <field name="product_name"/>
                        <field name="sku"/>
                        <field name="odoo_qty"/>
                        <field name="stoqflow_qty"/>
                        <field name="status"
                               widget="badge"
                               decoration-success="status == 'match'"
                               decoration-danger="status in ('mismatch', 'missing_in_stoqflow', 'missing_in_odoo')"
                               decoration-warning="status == 'unresolved'"/>
                        <field name="message"/>
                        <field name="stoqflow_product_id" optional="hide"/>
                    </list>
                </field>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
