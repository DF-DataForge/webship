<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="webship_backorder_confirm_delete_form" model="ir.ui.view">
        <field name="name">webship.backorder.confirm.delete.form</field>
        <field name="model">webship.backorder.confirm.delete</field>
        <field name="arch" type="xml">
            <form string="Confirm Delete">
                <group>
                    <field name="warning_message" widget="text" readonly="1" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Delete Anyway" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
