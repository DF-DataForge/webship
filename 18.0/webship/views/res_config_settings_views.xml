<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.hr.fleet</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="90"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="Stoqflow" id="webship" string="Stoqflow" name="webship">
                        <!-- API Connection: credentials and endpoints for the Stoqflow REST API -->
                        <block title="Login" id="ws_login_setting">
                            <setting>
                                <div class="text-muted content-group mt16">
                                    <span>Key: </span>
                                    <field name="webship_login" style="width: 500px" />
                                </div>
                                <div class="text-muted content-group mt16">
                                    <span>Secret: </span>
                                    <field name="webship_password" style="width: 500px" password="True"/>
                                </div>
                                <div class="text-muted content-group mt16">
                                    <span>Base Url: </span>
                                    <field name="webship_url" style="width: 500px"/>
                                </div>
                                <div class="text-muted content-group mt16">
                                    <span>App Url: </span>
                                    <field name="webship_app_url" style="width: 500px"/>
                                </div>
                                <div class="text-muted content-group mt16">
                                        <button string="Test connection" name="ws_test_verbinding" type="object" />
                                </div>
                                <div groups="base.group_no_one">
                                    <div class="mt16 text-muted">
                                        <strong>Developer-only options</strong>
                                    </div>
                                    <div class="mt8 d-flex align-items-center gap-2">
                                        <field name="webship_allow_write_requests" class="d-inline-block"/>
                                        <label for="webship_allow_write_requests"
                                               string="Perform PUT, POST, DELETE requests"
                                               class="fw-normal"/>
                                    </div>
                                    <div class="mt8 d-flex align-items-center gap-2">
                                        <field name="webship_skip_origin" class="d-inline-block"/>
                                        <label for="webship_skip_origin"
                                               string="Do not add origin when sending picking to Stoqflow (not recommended)"
                                               class="fw-normal"/>
                                    </div>
                                    <div class="text-muted mt4">
                                        Omits the 'origin' block from order payloads so Stoqflow's unique-origin constraint does not block re-sending a picking. Intended for testing only.
                                    </div>
                                </div>
                            </setting>
                        </block>

                        <!-- General settings: toggles and defaults that control how the integration behaves -->
                        <block title="General Settings" id="ws_algemene_instellingen">
                            <setting string="Order Sync" help="Control how delivery orders and purchase orders are synchronized with Stoqflow.">
                                <group>
                                    <field name="webship_sync_order"/>
                                    <field name="webship_order_available_condition"/>
                                    <field name="webship_auto_create_backorder"/>
                                    <field name="webship_fallback_sale_order_contact"/>
                                    <field name="webship_cancel_on_picking_cancel"/>
                                </group>
                            </setting>
                            <setting string="Default Statuses" help="Choose the initial status for new orders and purchase orders when they are created in Stoqflow.">
                                <group>
                                    <field name="webship_default_status"/>
                                    <field name="webship_default_po_status"/>
                                </group>
                            </setting>
                            <setting string="Brand &amp; Shop" help="Select the default brand and shop assigned to orders sent to Stoqflow. These must be loaded first using the button below.">
                                <group>
                                    <field name="webship_default_brand"/>
                                    <field name="webship_default_shop"/>
                                    <p><button icon="oi-arrow-right" name="ws_fetch_companies_and_warehouses" type="object" string="Load companies / brands / warehouses" class="btn-link"/></p>
                                </group>
                                <div class="text-muted">Companies, brands, and warehouses need to be loaded from the Stoqflow API before orders can be processed.</div>
                            </setting>
                            <setting string="Domain Filter" help="Optionally restrict which pickings are automatically synced to Stoqflow using an Odoo domain expression.">
                                <div class="mt16">
                                    <field name="webship_domain" widget="domain" options="{'model': 'stock.picking'}"/>
                                </div>
                                <div class="mt8">
                                    <label for="webship_domain_text" string="Domain rule" class="fw-normal"/>
                                    <field name="webship_domain_text" placeholder="[]" class="o_field_widget w-100"/>
                                </div>
                                <div class="text-muted">Only pickings matching this filter will be synced. Leave empty to sync all Stoqflow pickings.</div>
                            </setting>
                            <setting string="Logging &amp; Display" help="Configure extra UI elements and API logging for debugging.">
                                <group>
                                    <field name="webship_log_json"/>
                                    <field name="webship_show_parcels_tab"/>
                                    <field name="webship_show_pick_analysis_tab"/>
                                    <field name="webship_show_compare"/>
                                </group>
                            </setting>
                            <setting string="Ignored SKUs" help="Products whose SKU is listed here are skipped when orders are fetched from Stoqflow, so they do not trigger 'no matching product found on picking' warnings.">
                                <field name="webship_ignored_skus"
                                       widget="text"
                                       placeholder="1045&#10;2034, 2035&#10;PACKAGING-A"
                                       class="o_field_widget w-100"
                                       nolabel="1"/>
                                <div class="text-muted mt8">
                                    Enter one SKU per line, or separate multiple SKUs with commas. Use this for products that exist on the Stoqflow side but should not appear in Odoo (e.g. packaging items). Matching SKUs are silently skipped during order fetch.
                                </div>
                            </setting>
                        </block>

                        <!-- Couriers: load and link Stoqflow couriers to Odoo delivery carriers -->
                        <block title="Couriers" id="ws_couriers_block">
                            <setting string="Courier Mapping" help="Map couriers from Stoqflow to delivery carriers in Odoo.">
                                <group>
                                    <field name="webship_fetch_courier"/>
                                </group>
                                <div class="text-muted">
                                    When enabled, the preferred courier from Stoqflow orders is automatically mapped
                                    to the delivery carrier on the Odoo picking. If a courier is not yet linked, a
                                    warning is shown in the sync result.
                                </div>
                                <div class="mt16">
                                    <button icon="oi-arrow-right" name="ws_fetch_couriers" type="object"
                                            string="Load couriers from Stoqflow" class="btn-link"/>
                                </div>
                                <div class="mt8">
                                    <button icon="oi-arrow-right" type="action" name="%(stoqflow_courier_action)d"
                                            string="Manage Stoqflow couriers" class="btn-link"/>
                                </div>
                            </setting>
                        </block>

                        <!-- Contact Matching: configure how contacts are looked up in Stoqflow -->
                        <block title="Contact Matching" id="ws_contact_matching_block">
                            <setting string="Matching Sequence" help="Choose how Odoo searches for an existing client in Stoqflow before creating a new one. The matching sequence determines which field(s) are used and in what order.">
                                <group>
                                    <field name="webship_contact_match_sequence"/>
                                </group>
                                <div class="text-muted mt8">
                                    <ul class="mb-0">
                                        <li><strong>VAT → E-mail:</strong> First looks up a client with the same VAT number. If no match is found, it tries the e-mail address.</li>
                                        <li><strong>VAT only:</strong> Only looks up clients by VAT number. Contacts without a VAT number will not be matched.</li>
                                        <li><strong>E-mail only:</strong> Only looks up clients by e-mail address.</li>
                                        <li><strong>E-mail → VAT:</strong> First looks up a client with the same e-mail address. If no match is found, it tries the VAT number.</li>
                                        <li><strong>Leave blank:</strong> Matching is skipped. A new Stoqflow client is created whenever the Odoo partner has no df_client_id_webship yet.</li>
                                    </ul>
                                </div>
                            </setting>
                            <setting string="Automatic Matching" help="Control whether contacts are automatically matched when orders are sent to Stoqflow.">
                                <group>
                                    <field name="webship_match_on_order_sync"/>
                                </group>
                                <div class="text-muted">When enabled, each time an order is synced to Stoqflow the system will first attempt to find and link an existing Stoqflow client using the matching sequence above. This avoids creating duplicate clients in Stoqflow. If the matching sequence is left blank, this step is skipped and a new client is created whenever the Odoo partner has no df_client_id_webship yet.</div>
                            </setting>
                        </block>

                        <!-- Supplier Matching: configure how suppliers are looked up in Stoqflow -->
                        <block title="Supplier Matching" id="ws_supplier_matching_block">
                            <setting string="Matching Sequence" help="Choose how Odoo searches for an existing supplier in Stoqflow before creating a new one. The matching sequence determines which field(s) are used and in what order.">
                                <group>
                                    <field name="webship_supplier_match_sequence"/>
                                </group>
                                <div class="text-muted mt8">
                                    <ul class="mb-0">
                                        <li><strong>VAT &#x2192; E-mail:</strong> First looks up a supplier with the same VAT number. If no match is found, it tries the e-mail address.</li>
                                        <li><strong>VAT only:</strong> Only looks up suppliers by VAT number. Partners without a VAT number will not be matched.</li>
                                        <li><strong>E-mail only:</strong> Only looks up suppliers by e-mail address.</li>
                                        <li><strong>E-mail &#x2192; VAT:</strong> First looks up a supplier with the same e-mail address. If no match is found, it tries the VAT number.</li>
                                        <li><strong>Leave blank:</strong> Matching is skipped. A new Stoqflow supplier is created whenever the Odoo partner has no df_supplier_id_webship yet.</li>
                                    </ul>
                                </div>
                            </setting>
                            <setting string="Automatic Matching" help="Control whether suppliers are automatically matched when purchase orders are sent to Stoqflow.">
                                <group>
                                    <field name="webship_match_on_po_sync"/>
                                </group>
                                <div class="text-muted">When enabled, each time a purchase order is synced to Stoqflow the system will first attempt to find and link an existing Stoqflow supplier using the matching sequence above. This avoids creating duplicate suppliers in Stoqflow. If the matching sequence is left blank, this step is skipped and a new supplier is created whenever the Odoo partner has no df_supplier_id_webship yet.</div>
                            </setting>
                        </block>

                        <!-- Contact transfer options: settings that apply to both clients and suppliers -->
                        <block title="Contact Transfer Options" id="ws_contact_transfer_options_block">
                            <setting string="Allow contacts without e-mail" help="Control whether contacts (clients or suppliers) without an e-mail address can be transferred to Stoqflow.">
                                <group>
                                    <field name="webship_allow_no_email_contact"/>
                                </group>
                                <div class="text-muted">When enabled, contacts (clients or suppliers) without an e-mail address can be transferred to Stoqflow. When disabled, the sync returns an error if the contact has no e-mail address, so the missing data can be fixed before retrying.</div>
                            </setting>
                        </block>

                        <!-- Error notifications: configure who gets emailed when a queue error occurs -->
                        <block title="Error Notifications" id="ws_error_notifications_block">
                            <setting string="Notification Recipients" help="These recipients receive an email whenever an error occurs during queue processing (pending orders or status fetch).">
                                <div class="content-group mt16">
                                    <div><strong>Users</strong></div>
                                    <field name="webship_error_notify_user_ids" widget="many2many_tags"/>
                                </div>
                                <div class="content-group mt16">
                                    <div><strong>Additional email addresses</strong></div>
                                    <field name="webship_error_notify_emails" style="width: 500px" placeholder="email1@example.com, email2@example.com"/>
                                    <div class="text-muted">Comma-separated list of extra addresses to notify, in addition to the users above.</div>
                                </div>
                            </setting>
                        </block>

                        <!-- Daily report: configure who gets the daily processing summary -->
                        <block title="Daily Report" id="ws_daily_report_block">
                            <setting string="Report Recipients" help="These recipients receive a daily email summarising all pickings processed in the last 24 hours (successful and errored). The report is also sent automatically by the scheduled cron job.">
                                <div class="content-group mt16">
                                    <div><strong>Users</strong></div>
                                    <field name="webship_report_notify_user_ids" widget="many2many_tags"/>
                                </div>
                                <div class="content-group mt16">
                                    <div><strong>Additional email addresses</strong></div>
                                    <field name="webship_report_notify_emails" style="width: 500px" placeholder="email1@example.com, email2@example.com"/>
                                    <div class="text-muted">Comma-separated list of extra addresses, in addition to the users above.</div>
                                </div>
                                <div class="content-group mt16">
                                    <button icon="oi-arrow-right" name="ws_send_daily_report" type="object" string="Send report now" class="btn-link"/>
                                    <span class="text-muted ms-2">Send the report immediately for the last 24 hours.</span>
                                </div>
                            </setting>
                        </block>

                        <!-- Scheduled tasks: enable/disable each cron job and configure intervals -->
                        <block title="Scheduled Tasks" id="ws_scheduled_tasks_block">
                            <setting string="Cron Jobs" help="Enable or disable scheduled tasks and configure how frequently they run. Changes take effect immediately after saving.">
                                <div class="content-group mt16">
                                    <div class="row">
                                        <div class="col-md-6"><strong>Task</strong></div>
                                        <div class="col-md-2"><strong>Active</strong></div>
                                        <div class="col-md-4"><strong>Run every</strong></div>
                                    </div>
                                    <!-- Process pending orders -->
                                    <div class="row mt8 align-items-center">
                                        <div class="col-md-6">
                                            <span>Process pending orders</span>
                                        </div>
                                        <div class="col-md-2">
                                            <field name="webship_cron_sync_statusP" class="d-inline-block"/>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="d-flex gap-2 align-items-center">
                                                <field name="webship_cron_sync_statusP_interval_number" style="width: 60px" class="text-center"/>
                                                <field name="webship_cron_sync_statusP_interval_type" style="width: 100px"/>
                                                <button name="ws_run_cron_manually" type="object" string="Run manually"
                                                        confirm="Run manually?"
                                                        context="{'cron_xml_id': 'ir_cron_sync_statusP'}"
                                                        class="btn btn-link"/>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Fetch order info -->
                                    <div class="row mt8 align-items-center">
                                        <div class="col-md-6">
                                            <span>Fetch order info &amp; quantities</span>
                                        </div>
                                        <div class="col-md-2">
                                            <field name="webship_cron_sync_statussen" class="d-inline-block"/>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="d-flex gap-2 align-items-center">
                                                <field name="webship_cron_sync_statussen_interval_number" style="width: 60px" class="text-center"/>
                                                <field name="webship_cron_sync_statussen_interval_type" style="width: 100px"/>
                                                <button name="ws_run_cron_manually" type="object" string="Run manually"
                                                        confirm="Run manually?"
                                                        context="{'cron_xml_id': 'ir_cron_sync_statussen'}"
                                                        class="btn btn-link"/>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Import stock -->
                                    <div class="row mt8 align-items-center">
                                        <div class="col-md-6">
                                            <span>Import stock from Stoqflow</span>
                                            <div class="d-flex align-items-center gap-2 mt4">
                                                <field name="webship_adjust_odoo_stock" class="d-inline-block"/>
                                                <label for="webship_adjust_odoo_stock" string="Adjust Odoo stock automatically" class="text-muted mb0"/>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <field name="webship_cron_import_stock" class="d-inline-block"/>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="d-flex gap-2 align-items-center">
                                                <field name="webship_cron_import_stock_interval_number" style="width: 60px" class="text-center"/>
                                                <field name="webship_cron_import_stock_interval_type" style="width: 100px"/>
                                                <button name="ws_run_cron_manually" type="object" string="Run manually"
                                                        confirm="Run manually?"
                                                        context="{'cron_xml_id': 'ir_cron_import_stock'}"
                                                        class="btn btn-link"/>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Send daily report -->
                                    <div class="row mt8 align-items-center">
                                        <div class="col-md-6">
                                            <span>Send daily report</span>
                                        </div>
                                        <div class="col-md-2">
                                            <field name="webship_cron_daily_report" class="d-inline-block"/>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="d-flex gap-2 align-items-center">
                                                <field name="webship_cron_daily_report_interval_number" style="width: 60px" class="text-center"/>
                                                <field name="webship_cron_daily_report_interval_type" style="width: 100px"/>
                                                <button name="ws_run_cron_manually" type="object" string="Run manually"
                                                        confirm="Run manually?"
                                                        context="{'cron_xml_id': 'ir_cron_daily_report'}"
                                                        class="btn btn-link"/>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Fetch returns -->
                                    <div class="row mt8 align-items-center">
                                        <div class="col-md-6">
                                            <span>Fetch returns from Stoqflow</span>
                                        </div>
                                        <div class="col-md-2">
                                            <field name="webship_cron_sync_retours" class="d-inline-block"/>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="d-flex gap-2 align-items-center">
                                                <field name="webship_cron_sync_retours_interval_number" style="width: 60px" class="text-center"/>
                                                <field name="webship_cron_sync_retours_interval_type" style="width: 100px"/>
                                                <button name="ws_run_cron_manually" type="object" string="Run manually"
                                                        confirm="Run manually?"
                                                        context="{'cron_xml_id': 'ir_cron_sync_retours_and_backorders'}"
                                                        class="btn btn-link"/>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Fetch backorders -->
                                    <div class="row mt8 align-items-center">
                                        <div class="col-md-6">
                                            <span>Fetch backorders from Stoqflow</span>
                                        </div>
                                        <div class="col-md-2">
                                            <field name="webship_cron_auto_delete_backorders" class="d-inline-block"/>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="d-flex gap-2 align-items-center">
                                                <field name="webship_cron_auto_delete_backorders_interval_number" style="width: 60px" class="text-center"/>
                                                <field name="webship_cron_auto_delete_backorders_interval_type" style="width: 100px"/>
                                                <button name="ws_run_cron_manually" type="object" string="Run manually"
                                                        confirm="Run manually?"
                                                        context="{'cron_xml_id': 'ir_cron_auto_delete_backorders'}"
                                                        class="btn btn-link"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </setting>
                        </block>

                        <!-- Retours -->
                        <block title="Retours" id="ws_retours_block">
                            <setting string="Fetch Retours" help="Fetch retour purchase orders from Stoqflow. These are purchase orders with 'Retour' in the supplier reference, followed by the order code they refer to (e.g. 'Retour S000002').">
                                <p>
                                    <button icon="oi-arrow-right" name="ws_fetch_retours" type="object" string="Fetch retours from Stoqflow" class="btn-link"/>
                                    <span class="text-muted ms-2">Scans all purchase orders for retours and creates return pickings in Odoo.</span>
                                </p>
                            </setting>
                            <setting string="Auto insert retours in Odoo" help="Automatically create return pickings in Odoo from retours fetched by the scheduled cron job.">
                                <group>
                                    <field name="webship_auto_sync_retours"/>
                                </group>
                                <div class="text-muted">When enabled, the scheduled cron job automatically fetches retours from Stoqflow and creates return pickings in Odoo.</div>
                            </setting>
                        </block>

                        <!-- Backorders -->
                        <block title="Backorders" id="ws_backorders_block">
                            <setting string="Fetch Backorders" help="Fetch orders and purchase orders created after the pointers below; any record with a parent_order_id is stored as a backorder.">
                                <p>
                                    <button icon="oi-arrow-right" name="ws_fetch_backorders" type="object" string="Fetch backorders from Stoqflow" class="btn-link"/>
                                    <span class="text-muted ms-2">Fetches orders and purchase orders created since the pointers and stores those with a parent_order_id as backorders. The pointers advance to 'now' on success.</span>
                                </p>
                            </setting>
                            <setting string="Backorder fetch pointers" help="Editable datetime pointers used by the backorder fetch. Rewind to re-scan a wider window.">
                                <group>
                                    <field name="webship_last_check_date_backorder_order" string="Last order backorder check"/>
                                    <field name="webship_last_check_date_backorder_po" string="Last PO backorder check"/>
                                </group>
                            </setting>
                            <setting string="Auto delete backorders in Stoqflow" help="Automatically delete backorders from Stoqflow after they are fetched.">
                                <group>
                                    <field name="webship_auto_delete_backorders"/>
                                </group>
                                <div class="text-muted">When enabled, newly fetched backorders get process code 'P' (Pending) and are automatically deleted from Stoqflow by the scheduled cron job. After deletion the code changes to 'F'.</div>
                            </setting>
                        </block>

                        <!-- Stock Management -->
                        <block title="Stock Management" id="ws_stock_block_id">
                            <setting string="Load Stock from Stoqflow" help="Fetch current stock levels from Stoqflow and update inventory quantities in Odoo.">
                                <p>
                                    <button icon="oi-arrow-right" name="ws_import_stock" type="object" string="Load Stock from Stoqflow" class="btn-primary"/>
                                    <span class="text-muted ms-2">Manually fetch stock levels from the Stoqflow warehouse. This is also run automatically by the scheduled cron job.</span>
                                </p>
                            </setting>
                        </block>

                        <!-- Manual sync actions and last check timestamps -->
                        <block title="Synchronization" id="ws_synchr_block_id">
                            <setting string="Manual Actions" help="Trigger synchronization actions manually. These are also run automatically by the scheduled cron jobs.">
                                <p>
                                    <button icon="oi-arrow-right" name="ws_sync_all_pickings_statusP" type="object" string="Process pending orders" class="btn-link"/>
                                    <span class="text-muted ms-2">Push all pickings with status 'Pending' to the Stoqflow API.</span>
                                </p>
                                <p>
                                    <button icon="oi-arrow-right" name="ws_sync_statusses_since_last" type="object" string="Fetch order info" class="btn-link"/>
                                    <span class="text-muted ms-2">Retrieve the latest quantities and statuses from Stoqflow for all open pickings.</span>
                                </p>
                            </setting>
                            <setting string="Last Check Timestamps" help="Shows when the cron jobs last fetched status updates from Stoqflow.">
                                <group>
                                    <field name="webship_last_check_date_status" string="Last order status check"/>
                                    <field name="webship_last_check_po_date_status" string="Last PO status check"/>
                                </group>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>

        <record id="webship_config_settings_action" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
            <field name="context">{'module' : 'webship', 'bin_size': False}</field>
        </record>

        <menuitem id="webship_config_settings_menu" name="Settings"
            parent="webship.webship_root_menu" sequence="25"
                  action="webship_config_settings_action"
            groups="base.group_system"/>
    </data>
</odoo>
