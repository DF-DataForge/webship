<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Custom Stoqflow Search View for Pickings -->
    <record id="df_webship_orders_search_view" model="ir.ui.view">
        <field name="name">df.webship.orders.search</field>
        <field name="model">stock.picking</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <search string="Stoqflow Orders">
                <!-- Search fields -->
                <field name="name" string="Reference"/>
                <field name="partner_id" string="Contact"/>
                <field name="sale_id" string="Sale Order"/>
                <field name="origin" string="Source Document"/>
                <field name="df_picking_id_webship" string="Stoqflow ID"/>

                <!-- Filters: Process Code -->
                <separator/>
                <filter string="Pending" name="process_pending"
                        domain="[('df_process_code', '=', 'P')]"/>
                <filter string="Sent to Stoqflow" name="process_finished"
                        domain="[('df_process_code', '=', 'F')]"/>
                <filter string="Error" name="process_error"
                        domain="[('df_process_code', '=', 'E')]"/>
                <filter string="Manual" name="process_manual"
                        domain="[('df_process_code', '=', 'M')]"/>
                <filter string="Cancelled" name="process_cancelled"
                        domain="[('df_process_code', '=', 'C')]"/>

                <!-- Filters: Stoqflow Status -->
                <separator/>
                <filter string="Completed" name="status_completed"
                        domain="[('df_status_webship', '=', 'completed')]"/>
                <filter string="Ready to Pick" name="status_ready"
                        domain="[('df_status_webship', '=', 'ready-to-pick')]"/>
                <filter string="Picking / Packing" name="status_in_progress"
                        domain="[('df_status_webship', 'in', ('picking', 'ready-to-pack', 'packing'))]"/>
                <filter string="Ready to Ship" name="status_ready_to_ship"
                        domain="[('df_status_webship', '=', 'ready-to-ship')]"/>
                <filter string="On Hold" name="status_on_hold"
                        domain="[('df_status_webship', '=', 'on-hold')]"/>
                <filter string="Awaiting Payment" name="status_awaiting_payment"
                        domain="[('df_status_webship', '=', 'awaiting-payment')]"/>
                <filter string="Concept" name="status_concept"
                        domain="[('df_status_webship', '=', 'concept')]"/>
                <filter string="Cancelled" name="status_cancelled"
                        domain="[('df_status_webship', '=', 'cancelled')]"/>

                <!-- Filters: Odoo State -->
                <separator/>
                <filter string="Ready" name="state_assigned"
                        domain="[('state', '=', 'assigned')]"/>
                <filter string="Done" name="state_done"
                        domain="[('state', '=', 'done')]"/>
                <filter string="Waiting" name="state_confirmed"
                        domain="[('state', '=', 'confirmed')]"/>

                <!-- Filters: Object Type -->
                <separator/>
                <filter string="Orders" name="object_order"
                        domain="[('df_is_webship_source', '=', True), ('df_is_webship_destination', '=', False)]"/>
                <filter string="Purchase Orders" name="object_po"
                        domain="[('df_is_webship_destination', '=', True), ('df_is_webship_source', '=', False)]"/>

                <!-- Filters: Late -->
                <separator/>
                <filter string="Late" name="filter_late"
                        domain="[('scheduled_date', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', 'not in', ('done', 'cancel'))]"/>
                <filter string="Backorders" name="filter_backorder"
                        domain="[('backorder_id', '!=', False)]"/>

                <!-- Group By -->
                <group>
                    <filter string="Object in Stoqflow" name="group_object"
                            context="{'group_by': 'df_object_in_webship'}"/>
                    <filter string="Process Code" name="group_process_code"
                            context="{'group_by': 'df_process_code'}"/>
                    <filter string="Stoqflow Status" name="group_status_webship"
                            context="{'group_by': 'df_status_webship'}"/>
                    <filter string="Odoo Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <separator/>
                    <filter string="Scheduled Date" name="group_scheduled"
                            context="{'group_by': 'scheduled_date:day'}"/>
                    <filter string="Created Date" name="group_create_date"
                            context="{'group_by': 'create_date:day'}"/>
                    <filter string="Source Document" name="group_origin"
                            context="{'group_by': 'origin'}"/>
                    <filter string="Contact" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Custom Stoqflow Picking Tree View -->
    <record id="df_webship_orders_type_tree_view" model="ir.ui.view">
        <field name="name">df.webship.orders.type.tree</field>
        <field name="model">stock.picking</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list string="Stoqflow orders"
                  create="false"
                  edit="false"
                  default_order="create_date desc">

                <header>
                    <button name="ws_sync_allpickings"
                            string="Synchronisatie runnen"
                            type="object"
                            class="btn-primary"/>
                    <button name="fetchQuantities"
                            string="Haal hoeveelheden en status op"
                            type="object"
                            class="btn-secondary"/>
                    <button name="make_backorder"
                            string="Manueel backorder maken"
                            type="object"
                            class="btn-secondary"/>
                    <button name="export_stock_moves_xlsx"
                            string="Exporteer stock moves"
                            type="object"
                            class="btn-secondary"/>
                    <button name="compare_with_stoqflow"
                            string="Vergelijk met Stoqflow"
                            type="object"
                            class="btn-secondary"
                            groups="base.group_no_one"/>
                    <button name="fetch_client_name_webship"
                            string="Haal Stoqflow klantnaam op"
                            type="object"
                            class="btn-secondary"
                            groups="base.group_no_one"/>
                </header>

                <field name="create_date" optional="hide"/>
                <field name="df_object_in_webship"/>
                <field name="scheduled_date" widget="remaining_days" optional="hide"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="df_client_name_webship" string="Klant in Stoqflow"
                       optional="show" groups="base.group_no_one"/>
                <field name="df_status_webship"
                       widget="badge"
                       decoration-success="df_status_webship in ('completed', 'ready-to-ship')"
                       decoration-info="df_status_webship in ('ready-to-pick', 'picking', 'ready-to-pack', 'packing')"
                       decoration-warning="df_status_webship in ('on-hold', 'concept', 'awaiting-payment')"
                       decoration-muted="df_status_webship in ('ordered', False)"
                       decoration-danger="df_status_webship == 'cancelled'"/>
                <field name="df_picking_syncresult_webship" widget="html"/>
                <field name="df_compare_result_webship" widget="html" optional="hide" groups="base.group_no_one"/>
                <field name="df_url_order_or_po" widget="html"/>
                <field name="df_sale_order_link" widget="html" string="Sales Order"/>
                <field name="sale_id" string="Sales Order (raw)" optional="hide"/>

                <field name="df_process_code"
                       widget="badge"
                       decoration-warning="df_process_code == 'P'"
                       decoration-danger="df_process_code == 'E'"
                       decoration-success="df_process_code == 'F'"
                       decoration-muted="df_process_code in ('M', 'NA', 'C')"
                       readonly="1"/>

                <field name="state"
                       widget="badge"
                       decoration-danger="state == 'cancel'"
                       decoration-info="state == 'assigned'"
                       decoration-muted="state == 'draft'"
                       decoration-success="state == 'done'"
                       decoration-warning="state not in ('draft','cancel','done','assigned')"/>

                <button name="compare_with_stoqflow"
                        string="Compare"
                        type="object"
                        icon="fa-exchange"
                        groups="base.group_no_one"/>

                <button name="compare_detail"
                        string="Compare detail"
                        type="object"
                        icon="fa-search-plus"
                        groups="base.group_no_one"/>

            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="webship_orders_action" model="ir.actions.act_window">
        <field name="name">Stoqflow orders</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="df_webship_orders_type_tree_view"/>
        <field name="search_view_id" ref="df_webship_orders_search_view"/>
        <field name="domain">
            [
                '&amp;',
                    '|',
                        ('df_is_webship_source', '=', True),
                        ('df_is_webship_destination', '=', True),
                    ('state', 'in', ['confirmed', 'assigned', 'done'])
            ]
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No stoqflow orders yet. Check configuration or add a stoqflow order
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="webship_root_menu"
              name="Stoqflow"
              web_icon="webship,static/stoqflowicons/stoqflow-100x100.png"/>

    <menuitem id="webship_order_sub_root"
              name="Orders"
              parent="webship_root_menu"
              action="webship_orders_action"
              sequence="1"/>

    <menuitem id="webship_retour_sub_root"
              name="Retours"
              parent="webship_root_menu"
              action="webship_retour_and_backorder_action"
              sequence="3"/>

    <!-- Backorders List View (fetched from Stoqflow API) -->
    <record id="df_webship_backorders_list_view" model="ir.ui.view">
        <field name="name">df.webship.backorders.list</field>
        <field name="model">webship.backorder</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list string="Stoqflow Backorders" create="false" edit="false"
                  default_order="ws_created desc" decoration-muted="deleted == True">
                <header>
                    <button name="action_fetch_backorders"
                            string="Fetch Backorders"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_delete_in_webship"
                            string="Delete selected in Stoqflow"
                            type="object"
                            class="btn-danger"/>
                </header>
                <field name="ws_stoqflow_link" widget="html" string="Order"/>
                <field name="order_or_po" widget="badge"/>
                <field name="ws_product_sku"/>
                <field name="ws_backorder_qty"/>
                <field name="ws_client_name"/>
                <field name="parent_picking_id" widget="many2one" options="{'open': true}"/>
                <field name="odoo_backorder_picking_ids" widget="many2many_tags" options="{'open': true}"/>
                <field name="ws_status" widget="badge"
                       decoration-success="ws_status == 'completed'"
                       decoration-info="ws_status == 'ready-to-pick'"
                       decoration-warning="ws_status == 'on-hold'"
                       decoration-muted="ws_status == 'concept'"
                       decoration-danger="ws_status == 'cancelled'"/>
                <field name="ws_created"/>
                <field name="ws_edited"/>
                <field name="process_code" widget="badge"
                       decoration-warning="process_code == 'P'"
                       decoration-success="process_code == 'F'"
                       decoration-danger="process_code == 'E'"
                       optional="show"/>
                <field name="deleted" widget="boolean"/>
                <field name="deleted_date"/>
                <field name="ws_parent_order_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Backorders Form View -->
    <record id="df_webship_backorders_form_view" model="ir.ui.view">
        <field name="name">df.webship.backorders.form</field>
        <field name="model">webship.backorder</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <form string="Stoqflow Backorder" create="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Order Info">
                            <field name="ws_stoqflow_link" widget="html" string="Order link Stoqflow"/>
                            <field name="order_or_po" widget="badge"/>
                            <field name="ws_status" widget="badge"
                                   decoration-success="ws_status == 'completed'"
                                   decoration-info="ws_status == 'ready-to-pick'"
                                   decoration-warning="ws_status == 'on-hold'"
                                   decoration-muted="ws_status == 'concept'"
                                   decoration-danger="ws_status == 'cancelled'"/>
                            <field name="ws_client_name"/>
                            <field name="ws_product_sku"/>
                            <field name="ws_backorder_qty"/>
                        </group>
                        <group string="Pickings">
                            <field name="parent_picking_id" widget="many2one" options="{'open': true}"/>
                            <field name="ws_parent_stoqflow_link" widget="html" string="Parent Order in Stoqflow"/>
                        </group>
                    </group>
                    <group string="Backorder Pickings in Odoo">
                        <field name="odoo_backorder_picking_ids" nolabel="1">
                            <list create="false" delete="false" open="True">
                                <field name="name" string="Reference"/>
                                <field name="partner_id" string="Contact"/>
                                <field name="scheduled_date" string="Scheduled Date"/>
                                <field name="state" widget="badge"
                                       decoration-danger="state == 'cancel'"
                                       decoration-info="state == 'assigned'"
                                       decoration-muted="state == 'draft'"
                                       decoration-success="state == 'done'"
                                       decoration-warning="state not in ('draft','cancel','done','assigned')"/>
                            </list>
                        </field>
                    </group>
                    <group>
                        <group string="Timestamps &amp; Status">
                            <field name="ws_created"/>
                            <field name="ws_edited"/>
                            <field name="process_code" widget="badge"
                                   decoration-warning="process_code == 'P'"
                                   decoration-success="process_code == 'F'"
                                   decoration-danger="process_code == 'E'"/>
                            <field name="deleted"/>
                            <field name="deleted_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order JSON" name="order_json"
                              invisible="not ws_order_json">
                            <field name="ws_order_json" widget="text" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Backorders Action -->
    <record id="webship_backorders_action" model="ir.actions.act_window">
        <field name="name">Stoqflow Backorders</field>
        <field name="res_model">webship.backorder</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="df_webship_backorders_list_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No backorders found. Fetch backorders from Stoqflow to see them here.
            </p>
        </field>
    </record>

    <menuitem id="webship_backorders_menu"
              name="Backorders"
              parent="webship_root_menu"
              action="webship_backorders_action"
              sequence="4"/>

    <!-- Reports Menu -->
    <menuitem id="webship_reports_menu"
              name="Reports"
              parent="webship_root_menu"
              sequence="5"/>

    <menuitem id="webship_reports_products"
              name="Products in Stoqflow"
              parent="webship_reports_menu"
              action="stoqflow_product_report_action"
              sequence="1"/>

    <menuitem id="webship_reports_partners"
              name="Clients &amp; Suppliers in Stoqflow"
              parent="webship_reports_menu"
              action="stoqflow_partner_report_action"
              sequence="2"/>

    <!-- Configuration Menu -->
    <menuitem id="webship_config_menu"
              name="Configuration"
              parent="webship_root_menu"
              sequence="8"/>

    <menuitem id="webship_config_couriers"
              name="Stoqflow Couriers"
              parent="webship_config_menu"
              action="stoqflow_courier_action"
              sequence="1"/>

    <!-- Dashboard Menu -->
    <menuitem id="webship_dashboard_menu"
              name="Dashboard"
              parent="webship_root_menu"
              action="stoqflow_order_report_graph_action"
              sequence="10"/>

</odoo>