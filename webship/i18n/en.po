msgstr "API secret used for HTTP Basic Auth when connecting to the Stoqflow REST API."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_url
msgid "Base URL of the Stoqflow REST API, e.g. https://app.stoqflow.com/api/v2/. All API calls are sent to this address."
msgstr "Base URL of the Stoqflow REST API, e.g. https://app.stoqflow.com/api/v2/. All API calls are sent to this address."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_app_url
msgid "Base URL of the Stoqflow web application, e.g. https://app.stoqflow.com/. Used to build clickable links to orders and products in Stoqflow."
msgstr "Base URL of the Stoqflow web application, e.g. https://app.stoqflow.com/. Used to build clickable links to orders and products in Stoqflow."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_last_tested
msgid "Timestamp of the last successful API connection test."
msgstr "Timestamp of the last successful API connection test."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_last_check_date_status
msgid "Timestamp of the last time outbound order statuses were fetched from Stoqflow. Used by the cron job to avoid re-processing unchanged orders."
msgstr "Timestamp of the last time outbound order statuses were fetched from Stoqflow. Used by the cron job to avoid re-processing unchanged orders."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_last_check_po_date_status
msgid "Timestamp of the last time purchase order statuses were fetched from Stoqflow. Used by the cron job to avoid re-processing unchanged purchase orders."
msgstr "Timestamp of the last time purchase order statuses were fetched from Stoqflow. Used by the cron job to avoid re-processing unchanged purchase orders."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_modus
msgid "General synchronization mode. 'Sync required' enables automatic order syncing, 'Sync not required' disables it."
msgstr "General synchronization mode. 'Sync required' enables automatic order syncing, 'Sync not required' disables it."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_sync_order
msgid "When enabled, new delivery orders are automatically marked for synchronization with Stoqflow (process code 'P'). The cron job will then push them to the Stoqflow API."
msgstr "When enabled, new delivery orders are automatically marked for synchronization with Stoqflow (process code 'P'). The cron job will then push them to the Stoqflow API."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_sync_producten
msgid "When enabled, products can be synchronized with Stoqflow. Product data (SKU, name, prices, barcode) will be pushed to the Stoqflow API."
msgstr "When enabled, products can be synchronized with Stoqflow. Product data (SKU, name, prices, barcode) will be pushed to the Stoqflow API."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_sync_klanten
msgid "When enabled, customer/client data from Odoo partners will be synchronized with the Stoqflow API."
msgstr "When enabled, customer/client data from Odoo partners will be synchronized with the Stoqflow API."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_sync_leveranciers
msgid "When enabled, supplier data from Odoo partners will be synchronized with the Stoqflow API."
msgstr "When enabled, supplier data from Odoo partners will be synchronized with the Stoqflow API."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_do_not_match_client_before_create
msgid "When enabled, Stoqflow will always create a new client instead of trying to match an existing one first. Use this if you experience duplicate matching issues."
msgstr "When enabled, Stoqflow will always create a new client instead of trying to match an existing one first. Use this if you experience duplicate matching issues."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_auto_create_backorder
msgid "When enabled, a backorder is automatically created in Odoo when Stoqflow reports an order as completed with partial quantities."
msgstr "When enabled, a backorder is automatically created in Odoo when Stoqflow reports an order as completed with partial quantities."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_log_json
msgid "When enabled, every JSON payload sent to and received from the Stoqflow API is saved in the JSON History log. Useful for debugging synchronization issues."
msgstr "When enabled, every JSON payload sent to and received from the Stoqflow API is saved in the JSON History log. Useful for debugging synchronization issues."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_show_parcels_tab
msgid "When enabled, a 'Stoqflow Parcels' tab is shown on the picking form view displaying parcel details (tracking numbers, dimensions, shipping info) fetched from Stoqflow."
msgstr "When enabled, a 'Stoqflow Parcels' tab is shown on the picking form view displaying parcel details (tracking numbers, dimensions, shipping info) fetched from Stoqflow."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__testSku
msgid "Enter a product SKU for testing Stoqflow API calls."
msgstr "Enter a product SKU for testing Stoqflow API calls."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_order_available_condition
msgid "When enabled, orders are only synchronized to Stoqflow when all products have sufficient stock available at the source location. Orders with insufficient stock will remain pending."
msgstr "When enabled, orders are only synchronized to Stoqflow when all products have sufficient stock available at the source location. Orders with insufficient stock will remain pending."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_default_status
msgid "The initial status assigned to outbound orders when they are created in Stoqflow. 'Concept' = draft, 'Ready to pick' = immediately available for warehouse picking, 'On hold' = paused."
msgstr "The initial status assigned to outbound orders when they are created in Stoqflow. 'Concept' = draft, 'Ready to pick' = immediately available for warehouse picking, 'On hold' = paused."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_default_po_status
msgid "The initial status assigned to purchase orders (inbound goods) when they are created in Stoqflow. 'Concept' = draft, 'Ordered' = goods expected at the warehouse."
msgstr "The initial status assigned to purchase orders (inbound goods) when they are created in Stoqflow. 'Concept' = draft, 'Ordered' = goods expected at the warehouse."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_default_brand
msgid "The brand assigned to orders sent to Stoqflow. Brands are loaded from the Stoqflow API using the 'Load companies/brands/warehouses' button."
msgstr "The brand assigned to orders sent to Stoqflow. Brands are loaded from the Stoqflow API using the 'Load companies/brands/warehouses' button."

#. module: webship
#: model:ir.model.fields,help:webship.field_res_config_settings__webship_default_shop
msgid "The shop assigned to orders sent to Stoqflow. Shops belong to a brand and are loaded from the Stoqflow API using the 'Load companies/brands/warehouses' button."
msgstr "The shop assigned to orders sent to Stoqflow. Shops belong to a brand and are loaded from the Stoqflow API using the 'Load companies/brands/warehouses' button."

