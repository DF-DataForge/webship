#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.view_order_form_inherit_pickings_button
msgid ""
"<span class=\"o_stat_text\">Deliveries</span>\n"
"            <span class=\"o_stat_value\" field=\"picking_count\"/>"
msgstr ""
"<span class=\"o_stat_text\">Leveringen</span> <span class=\"o_stat_value\" "
"field=\"picking_count\"/>"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<span class=\"text-muted ms-2\">Fetch only the orders and purchase orders "
"changed in Stoqflow since the last check (edited_after) and update the "
"matched pickings. Also run automatically by the 'Stoqflow fetch changed "
"orders' cron job when incremental status updates are enabled.</span>"
msgstr ""
"<span class=\"text-muted ms-2\">Haalt enkel de orders en inkooporders op die"
" in Stoqflow gewijzigd zijn sinds de laatste controle (edited_after) en "
"werkt de gekoppelde overboekingen bij. Wordt ook automatisch uitgevoerd door"
" de geplande actie 'Stoqflow fetch changed orders' wanneer incrementele "
"statusupdates actief zijn.</span>"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<span class=\"text-muted ms-2\">Fetches orders and purchase orders created "
"since the pointers and stores those with a parent_order_id as backorders. "
"The pointers advance to 'now' on success.</span>"
msgstr ""
"<span class=\"text-muted ms-2\">Haalt de orders en inkooporders op die "
"aangemaakt zijn sinds de pointers en bewaart die met een parent_order_id als"
" backorder. De pointers schuiven bij succes door naar 'nu'.</span>"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<span class=\"text-muted ms-2\">Manually fetch stock levels from the "
"Stoqflow warehouse. This is also run automatically by the scheduled cron "
"job.</span>"
msgstr ""
"<span class=\"text-muted ms-2\">Haalt de voorraadniveaus manueel op uit het "
"Stoqflow-magazijn. Dit gebeurt ook automatisch via de geplande actie.</span>"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<span class=\"text-muted ms-2\">Push all pickings with status 'Pending' to "
"the Stoqflow API.</span>"
msgstr ""
"<span class=\"text-muted ms-2\">Stuurt alle overboekingen met status 'In "
"afwachting' naar de Stoqflow-API.</span>"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<span class=\"text-muted ms-2\">Retrieve the latest quantities and statuses "
"from Stoqflow for all open pickings.</span>"
msgstr ""
"<span class=\"text-muted ms-2\">Haalt de laatste hoeveelheden en statussen "
"uit Stoqflow op voor alle open overboekingen.</span>"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<span class=\"text-muted ms-2\">Scans all purchase orders for retours and "
"creates return pickings in Odoo.</span>"
msgstr ""
"<span class=\"text-muted ms-2\">Doorloopt alle inkooporders op zoek naar "
"retours en maakt de retourleveringen aan in Odoo.</span>"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<span class=\"text-muted ms-2\">Send the report immediately for the last 24 "
"hours.</span>"
msgstr ""
"<span class=\"text-muted ms-2\">Verstuur het rapport onmiddellijk voor de "
"laatste 24 uur.</span>"

