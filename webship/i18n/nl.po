#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "<strong>E-mail only:</strong> Only looks up clients by e-mail address."
msgstr "<strong>Enkel e-mail:</strong> Zoekt klanten enkel op e-mailadres."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<strong>E-mail only:</strong> Only looks up suppliers by e-mail address."
msgstr ""
"<strong>Enkel e-mail:</strong> Zoekt leveranciers enkel op e-mailadres."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<strong>E-mail → VAT:</strong> First looks up a client with the same e-mail "
"address. If no match is found, it tries the VAT number."
msgstr ""
"<strong>E-mail → btw:</strong> Zoekt eerst een klant met hetzelfde "
"e-mailadres; als er geen match is, wordt het btw-nummer gebruikt."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<strong>E-mail → VAT:</strong> First looks up a supplier with the same "
"e-mail address. If no match is found, it tries the VAT number."
msgstr ""
"<strong>E-mail → btw:</strong> Zoekt eerst een leverancier met hetzelfde "
"e-mailadres; als er geen match is, wordt het btw-nummer gebruikt."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<strong>Leave blank:</strong> Matching is skipped. A new Stoqflow client is "
"created whenever the Odoo partner has no df_client_id_webship yet."
msgstr ""
"<strong>Leeg laten:</strong> Matchen wordt overgeslagen. Er wordt een nieuwe"
" Stoqflow-klant aangemaakt zodra de Odoo-relatie nog geen "
"df_client_id_webship heeft."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<strong>Leave blank:</strong> Matching is skipped. A new Stoqflow supplier "
"is created whenever the Odoo partner has no df_supplier_id_webship yet."
msgstr ""
"<strong>Leeg laten:</strong> Matchen wordt overgeslagen. Er wordt een nieuwe"
" Stoqflow-leverancier aangemaakt zodra de Odoo-relatie nog geen "
"df_supplier_id_webship heeft."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "<strong>Run every</strong>"
msgstr "<strong>Uitvoeren elke</strong>"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "<strong>Task</strong>"
msgstr "<strong>Taak</strong>"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid "<strong>Users</strong>"
msgstr "<strong>Gebruikers</strong>"

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<strong>VAT only:</strong> Only looks up clients by VAT number. Contacts "
"without a VAT number will not be matched."
msgstr ""
"<strong>Enkel btw:</strong> Zoekt klanten enkel op btw-nummer. Contacten "
"zonder btw-nummer worden niet gematcht."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<strong>VAT only:</strong> Only looks up suppliers by VAT number. Partners "
"without a VAT number will not be matched."
msgstr ""
"<strong>Enkel btw:</strong> Zoekt leveranciers enkel op btw-nummer. Relaties"
" zonder btw-nummer worden niet gematcht."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<strong>VAT → E-mail:</strong> First looks up a client with the same VAT "
"number. If no match is found, it tries the e-mail address."
msgstr ""
"<strong>Btw → e-mail:</strong> Zoekt eerst een klant met hetzelfde btw-"
"nummer; als er geen match is, wordt het e-mailadres gebruikt."

#. module: webship
#: model_terms:ir.ui.view,arch_db:webship.res_config_settings_view_form
msgid ""
"<strong>VAT → E-mail:</strong> First looks up a supplier with the same VAT "
"number. If no match is found, it tries the e-mail address."
msgstr ""
"<strong>Btw → e-mail:</strong> Zoekt eerst een leverancier met hetzelfde "
"btw-nummer; als er geen match is, wordt het e-mailadres gebruikt."

