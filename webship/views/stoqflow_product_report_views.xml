<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--   PRODUCT REPORT: Products linked to Stoqflow/Webship         -->
    <!-- ============================================================ -->

    <!-- Tree View: Product variants linked to Stoqflow -->
    <record id="stoqflow_product_report_tree_view" model="ir.ui.view">
        <field name="name">stoqflow.product.report.tree</field>
        <field name="model">product.product</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list string="Stoqflow Products"
                  create="false"
                  edit="false"
                  default_order="write_date desc">

                <field name="default_code" string="SKU"/>
                <field name="name" string="Product Name"/>
                <field name="product_template_variant_value_ids" widget="many2many_tags" string="Variant" optional="show"/>
                <field name="categ_id" string="Category"/>
                <field name="barcode"/>
                <field name="list_price" string="Sales Price"/>
                <field name="standard_price" string="Cost"/>
                <field name="df_url_prod" widget="html" string="Product in Stoqflow"/>
                <field name="df_product_lastsync_webship" string="Last Sync"/>
                <field name="df_product_syncresult_webship" widget="html" string="Sync Result"/>
                <field name="df_product_do_not_send_webship" string="Excluded"/>
            </list>
        </field>
    </record>

    <!-- Search View: Filters for Stoqflow product report -->
    <record id="stoqflow_product_report_search_view" model="ir.ui.view">
        <field name="name">stoqflow.product.report.search</field>
        <field name="model">product.product</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <search string="Search Stoqflow Products">
                <field name="name" string="Product"/>
                <field name="default_code" string="SKU"/>
                <field name="categ_id" string="Category"/>
                <field name="barcode"/>
                <separator/>
                <filter string="Synced" name="synced"
                        domain="[('df_product_syncresult_webship', 'ilike', 'success')]"/>
                <filter string="Sync Errors" name="sync_errors"
                        domain="[('df_product_syncresult_webship', 'ilike', 'error')]"/>
                <filter string="Never Synced" name="never_synced"
                        domain="[('df_product_lastsync_webship', '=', False)]"/>
                <separator/>
                <filter string="Excluded from Sync" name="excluded"
                        domain="[('df_product_do_not_send_webship', '=', True)]"/>
                <filter string="Active for Sync" name="active_sync"
                        domain="[('df_product_do_not_send_webship', '=', False)]"/>
                <separator/>
                <group>
                    <filter string="Category" name="group_category"
                            context="{'group_by': 'categ_id'}"/>
                    <filter string="Sync Result" name="group_sync_result"
                            context="{'group_by': 'df_product_syncresult_webship'}"/>
                    <filter string="Last Sync (Month)" name="group_last_sync"
                            context="{'group_by': 'df_product_lastsync_webship:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Stoqflow Products Report -->
    <record id="stoqflow_product_report_action" model="ir.actions.act_window">
        <field name="name">Products in Stoqflow</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="stoqflow_product_report_search_view"/>
        <field name="domain">[('df_product_id_webship', '!=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No products linked to Stoqflow yet.
            </p>
            <p>
                Sync your products with Stoqflow to see them listed here.
            </p>
        </field>
    </record>

    <!-- Explicit view binding so Odoo uses our custom tree, not the default -->
    <record id="stoqflow_product_report_action_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="stoqflow_product_report_tree_view"/>
        <field name="act_window_id" ref="stoqflow_product_report_action"/>
    </record>

</odoo>
