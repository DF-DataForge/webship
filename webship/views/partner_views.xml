<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="partner_form_view_inherit_webship" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.webship</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Stoqflow" name="webship">

                    <group>
                        <field name="df_is_supplier_in_webship" string="Sync as supplier" help="Check to create/update this contact as a supplier in Stoqflow"/>
                        <field name="df_is_client_in_webship" string="Sync as client" help="Check to create/update this contact as a client in Stoqflow"/>
                    </group>

                    <separator string="Contact Status" colspan="2"/>
                    <group>
                        <field name="df_url_client" colspan="2" nolabel="1"/>
                        <field name="df_url_supplier" colspan="2" nolabel="1"/>
                        <field name="df_last_webship_sync" readonly="1" string="Last sync"/>
                    </group>

                    <group colspan="2">
                        <field name="df_partner_syncresult_webship"
                               readonly="1"
                               widget="html"
                               string="Sync Status"/>
                    </group>

                    <separator string="Stoqflow Synchronization"/>
                    <group col="2">
                        <group>
                            <h5>🔗 Match Contact</h5>
                            <p style="font-size: 12px; color: #666; margin-bottom: 12px;">
                                Search Stoqflow for a contact matching this email address and link it. Use when the contact already exists in Stoqflow.
                            </p>
                            <button name="ws_match_partner"
                                    type="object"
                                    string="Match with Stoqflow"
                                    class="btn btn-secondary"
                                    style="width: 100%; padding: 10px 16px; border-radius: 2px;"/>
                        </group>
                        <group>
                            <h5>➕ Create &amp; Sync</h5>
                            <p style="font-size: 12px; color: #666; margin-bottom: 12px;">
                                Push this contact to Stoqflow. Creates new if email doesn't exist, or updates existing. If email already exists, use "Match" instead.
                            </p>
                            <button name="ws_sync_partner"
                                    type="object"
                                    string="Sync with Stoqflow"
                                    class="btn btn-primary"
                                    style="width: 100%; padding: 10px 16px; border-radius: 2px;"/>
                        </group>
                    </group>

                </page>
            </xpath>

        </field>
    </record>

</odoo>