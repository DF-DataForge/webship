<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="saleorder_form_view_inherit_webship" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.webship</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Webship" name="Webship">
                    <group string="Velden Webship" name="Webshipgroup">
                        <field name="df_order_id_webship" readonly="1"></field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
