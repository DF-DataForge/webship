<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Search View -->
    <record id="webship_retour_and_backorder_search_view" model="ir.ui.view">
        <field name="name">webship.retour.and.backorder.search</field>
        <field name="model">webship.retour.and.backorder</field>
        <field name="arch" type="xml">
            <search string="Retours">
                <field name="name" string="Order Number"/>
                <field name="supplier_reference"/>
                <field name="tracking_numbers"/>
                <field name="supplier_id"/>
                <field name="df_original_order_ref"/>

                <separator/>
                <filter string="Concept" name="status_concept"
                        domain="[('status', '=', 'concept')]"/>
                <filter string="Ordered" name="status_ordered"
                        domain="[('status', '=', 'ordered')]"/>
                <filter string="In Transit" name="status_in_transit"
                        domain="[('status', '=', 'in-transit')]"/>
                <filter string="Delivered" name="status_delivered"
                        domain="[('status', '=', 'delivered')]"/>
                <filter string="Unpacking" name="status_unpacking"
                        domain="[('status', '=', 'unpacking')]"/>
                <filter string="On Hold" name="status_on_hold"
                        domain="[('status', '=', 'on-hold')]"/>
                <filter string="Completed" name="status_completed"
                        domain="[('status', '=', 'completed')]"/>
                <filter string="Cancelled" name="status_cancelled"
                        domain="[('status', '=', 'cancelled')]"/>

                <separator/>
                <filter string="Orders" name="filter_orders"
                        domain="[('order_or_po', '=', 'order')]"/>
                <filter string="Purchase Orders" name="filter_po"
                        domain="[('order_or_po', '=', 'purchase_order')]"/>

                <group>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'status'}"/>
                    <filter string="Object in Stoqflow" name="group_order_or_po"
                            context="{'group_by': 'order_or_po'}"/>
                    <filter string="Supplier" name="group_supplier"
                            context="{'group_by': 'supplier_id'}"/>
                    <filter string="Created Month" name="group_created_month"
                            context="{'group_by': 'created:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Tree View -->
    <record id="webship_retour_and_backorder_tree_view" model="ir.ui.view">
        <field name="name">webship.retour.and.backorder.tree</field>
        <field name="model">webship.retour.and.backorder</field>
        <field name="arch" type="xml">
            <list string="Retours"
                  create="false"
                  default_order="created desc">

                <header>
                    <button name="action_sync_retours"
                            string="Sync Retours"
                            type="object"
                            class="btn-primary"/>
                </header>

                <field name="name"/>
                <field name="order_or_po"/>
                <field name="supplier_reference"/>
                <field name="status"
                       widget="badge"
                       decoration-success="status in ('completed', 'delivered')"
                       decoration-info="status in ('in-transit', 'unpacking')"
                       decoration-warning="status in ('on-hold', 'concept')"
                       decoration-muted="status == 'ordered'"
                       decoration-danger="status == 'cancelled'"/>
                <field name="tracking_numbers"/>
                <field name="supplier_id"/>
                <field name="df_original_order_ref"/>
                <field name="sale_order_id"/>
                <field name="df_process_code" widget="badge"
                       decoration-info="df_process_code == 'P'"
                       decoration-success="df_process_code == 'F'"
                       decoration-danger="df_process_code == 'E'"/>
                <field name="return_picking_id"/>
                <field name="created"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="webship_retour_and_backorder_form_view" model="ir.ui.view">
        <field name="name">webship.retour.and.backorder.form</field>
        <field name="model">webship.retour.and.backorder</field>
        <field name="arch" type="xml">
            <form string="Retour" create="false">
                <header>
                    <button name="action_create_return_picking"
                            string="Create Return Picking"
                            type="object"
                            class="btn-primary"
                            invisible="return_picking_id"/>
                </header>
                <sheet>
                    <group>
                        <group string="Retour Info">
                            <field name="ws_stoqflow_link" widget="html" string="Order Number" readonly="1"/>
                            <field name="status" widget="badge"
                                   decoration-success="status in ('completed', 'delivered')"
                                   decoration-info="status in ('in-transit', 'unpacking')"
                                   decoration-warning="status in ('on-hold', 'concept')"
                                   decoration-muted="status == 'ordered'"
                                   decoration-danger="status == 'cancelled'"
                                   readonly="1"/>
                            <field name="order_or_po" readonly="1"/>
                            <field name="ws_supplier_link" widget="html" string="Supplier" readonly="1"/>
                            <field name="supplier_reference" readonly="1"/>
                            <field name="ws_original_order_link" widget="html" string="Original Sale Order" readonly="1"/>
                        </group>
                        <group string="Tracking &amp; Warehouse">
                            <field name="tracking_numbers" readonly="1"/>
                            <field name="warehouse_id" readonly="1"/>
                            <field name="created" readonly="1"/>
                            <field name="picking_id" readonly="1"/>
                            <field name="original_picking_sale_order_id" readonly="1"/>
                            <field name="return_picking_id" readonly="1"/>
                            <field name="df_process_code" widget="badge" readonly="1"
                                   decoration-info="df_process_code == 'P'"
                                   decoration-success="df_process_code == 'F'"
                                   decoration-danger="df_process_code == 'E'"/>
                            <field name="df_error_message" readonly="1"
                                   invisible="df_process_code != 'E'"
                                   string="Error Message"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Return Lines" name="return_lines">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="product_display" string="Product"/>
                                    <field name="stoqflow_product_link" widget="html" string="Stoqflow Product"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                        <page string="Order JSON" name="order_json"
                              groups="base.group_no_one"
                              invisible="not ws_order_json">
                            <field name="ws_order_json" widget="text" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="webship_retour_and_backorder_action" model="ir.actions.act_window">
        <field name="name">Stoqflow Retours</field>
        <field name="res_model">webship.retour.and.backorder</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="webship_retour_and_backorder_search_view"/>
        <field name="context">{'search_default_group_status': 1}</field>
    </record>

</odoo>
