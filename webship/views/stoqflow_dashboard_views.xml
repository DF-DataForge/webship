<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--        CONNECTOR DASHBOARD: Orders, Prices & Margins          -->
    <!-- ============================================================ -->

    <!-- Graph View (Bar chart: orders per day) -->
    <record id="stoqflow_order_report_graph_view" model="ir.ui.view">
        <field name="name">stoqflow.order.report.graph</field>
        <field name="model">stoqflow.order.report</field>
        <field name="arch" type="xml">
            <graph string="Orders per Day" type="bar" stacked="False">
                <field name="date" type="row" interval="day"/>
                <field name="order_count" type="measure"/>
                <field name="sale_price" type="measure"/>
                <field name="cost_price" type="measure"/>
                <field name="margin" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="stoqflow_order_report_pivot_view" model="ir.ui.view">
        <field name="name">stoqflow.order.report.pivot</field>
        <field name="model">stoqflow.order.report</field>
        <field name="arch" type="xml">
            <pivot string="Order Margin Analysis">
                <field name="date" type="row" interval="day"/>
                <field name="order_count" type="measure"/>
                <field name="sale_price" type="measure"/>
                <field name="cost_price" type="measure"/>
                <field name="margin" type="measure"/>
                <field name="margin_percent" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- List View -->
    <record id="stoqflow_order_report_tree_view" model="ir.ui.view">
        <field name="name">stoqflow.order.report.tree</field>
        <field name="model">stoqflow.order.report</field>
        <field name="arch" type="xml">
            <list string="Connector Orders" create="false" edit="false"
                  default_order="date desc">
                <field name="date"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="order_type"/>
                <field name="stoqflow_status"
                       widget="badge"
                       decoration-success="stoqflow_status == 'completed'"
                       decoration-info="stoqflow_status in ('ready-to-pick', 'packing')"
                       decoration-warning="stoqflow_status == 'on-hold'"
                       decoration-muted="stoqflow_status == 'not synced'"/>
                <field name="sale_price" sum="Total Sale"/>
                <field name="cost_price" sum="Total Cost"/>
                <field name="margin" sum="Total Margin"
                       decoration-success="margin &gt; 0"
                       decoration-danger="margin &lt; 0"/>
                <field name="margin_percent"
                       decoration-success="margin_percent &gt; 0"
                       decoration-danger="margin_percent &lt; 0"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="stoqflow_order_report_search_view" model="ir.ui.view">
        <field name="name">stoqflow.order.report.search</field>
        <field name="model">stoqflow.order.report</field>
        <field name="arch" type="xml">
            <search string="Search Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <separator/>
                <filter string="Outbound Orders" name="outbound"
                        domain="[('order_type', '=', 'order')]"/>
                <filter string="Purchase Orders" name="inbound"
                        domain="[('order_type', '=', 'purchase_order')]"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('date', '=', context_today().strftime('%%Y-%%m-%%d'))]"/>
                <filter string="This Week" name="this_week"
                        domain="[('date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%%Y-%%m-%%d'))]"/>
                <filter string="This Month" name="this_month"
                        domain="[('date', '&gt;=', context_today().strftime('%%Y-%%m-01'))]"/>
                <separator/>
                <group>
                    <filter string="Day" name="group_day"
                            context="{'group_by': 'date:day'}"/>
                    <filter string="Week" name="group_week"
                            context="{'group_by': 'date:week'}"/>
                    <filter string="Month" name="group_month"
                            context="{'group_by': 'date:month'}"/>
                    <filter string="Type" name="group_order_type"
                            context="{'group_by': 'order_type'}"/>
                    <filter string="Customer" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Dashboard Action -->
    <record id="stoqflow_order_report_graph_action" model="ir.actions.act_window">
        <field name="name">Connector Dashboard</field>
        <field name="res_model">stoqflow.order.report</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="stoqflow_order_report_search_view"/>
        <field name="context">{'search_default_group_day': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No orders processed by the connector yet.
            </p>
            <p>
                Sync your orders with Stoqflow to see daily volumes, prices, and margins.
            </p>
        </field>
    </record>

</odoo>
