<odoo>
    <data noupdate="1">
        <record id="ir_cron_sync_statussen" model="ir.cron">
            <field name="name">Stoqflow sync statusses</field>
            <field name="model_id" ref="base.model_res_config_settings"/>
            <field name="state">code</field>
            <field name="code">model.ws_sync_statusses_since_last()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
        <record id="ir_cron_sync_statusP" model="ir.cron">
            <field name="name">Stoqflow sync status P</field>
            <field name="model_id" ref="base.model_res_config_settings"/>
            <field name="state">code</field>
            <field name="code">model.ws_sync_all_pickings_statusP()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
        <record id="ir_cron_import_stock" model="ir.cron">
            <field name="name">Stoqflow import stock</field>
            <field name="model_id" ref="base.model_res_config_settings"/>
            <field name="state">code</field>
            <field name="code">model.ws_import_stock()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
        <record id="ir_cron_daily_report" model="ir.cron">
            <field name="name">Stoqflow daily processing report</field>
            <field name="model_id" ref="base.model_res_config_settings"/>
            <field name="state">code</field>
            <field name="code">model.ws_send_daily_report()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
