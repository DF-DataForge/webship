<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Standalone tree view for webship.parcel (used by One2many on stock.picking) -->
    <record id="webship_parcel_view_tree" model="ir.ui.view">
        <field name="name">webship.parcel.view.tree</field>
        <field name="model">webship.parcel</field>
        <field name="arch" type="xml">
            <tree>
                <field name="df_number" string="#"/>
                <field name="df_tracking_number"/>
                <field name="df_tracking_url" widget="url"/>
                <field name="df_provider"/>
                <field name="df_weight"/>
                <field name="df_shipping_cost"/>
                <field name="df_shipping_name"/>
                <field name="df_shipping_city"/>
                <field name="df_shipping_country"/>
                <field name="df_label_url" widget="url"/>
            </tree>
        </field>
    </record>

    <!-- Standalone tree view for webship.parcel.content (used by One2many in parcel form) -->
    <record id="webship_parcel_content_view_tree" model="ir.ui.view">
        <field name="name">webship.parcel.content.view.tree</field>
        <field name="model">webship.parcel.content</field>
        <field name="arch" type="xml">
            <tree>
                <field name="df_sku"/>
                <field name="df_description"/>
                <field name="df_quantity"/>
                <field name="df_weight"/>
                <field name="df_hs_code"/>
                <field name="df_origin_country"/>
                <field name="df_value"/>
            </tree>
        </field>
    </record>

    <!-- Standalone tree view for webship.parcel.resource (used by One2many in parcel form) -->
    <record id="webship_parcel_resource_view_tree" model="ir.ui.view">
        <field name="name">webship.parcel.resource.view.tree</field>
        <field name="model">webship.parcel.resource</field>
        <field name="arch" type="xml">
            <tree>
                <field name="df_name"/>
                <field name="df_quantity"/>
            </tree>
        </field>
    </record>

    <!-- Standalone form view for webship.parcel -->
    <record id="webship_parcel_view_form" model="ir.ui.view">
        <field name="name">webship.parcel.view.form</field>
        <field name="model">webship.parcel</field>
        <field name="arch" type="xml">
            <form string="Parcel Details">
                <group>
                    <group string="Parcel Info">
                        <field name="df_number"/>
                        <field name="df_tracking_number"/>
                        <field name="df_tracking_url" widget="url"/>
                        <field name="df_label_url" widget="url"/>
                        <field name="df_invoice_url" widget="url"/>
                        <field name="df_provider"/>
                        <field name="df_provider_id"/>
                    </group>
                    <group string="Dimensions &amp; Cost">
                        <field name="df_weight"/>
                        <field name="df_width"/>
                        <field name="df_height"/>
                        <field name="df_length"/>
                        <field name="df_shipping_cost"/>
                    </group>
                    <group string="Shipping Address">
                        <field name="df_shipping_name"/>
                        <field name="df_shipping_company"/>
                        <field name="df_shipping_address"/>
                        <field name="df_shipping_postal_code"/>
                        <field name="df_shipping_city"/>
                        <field name="df_shipping_country"/>
                    </group>
                </group>
                <separator string="Contents"/>
                <field name="df_content_ids" nolabel="1"/>
                <separator string="Resources"/>
                <field name="df_resource_ids" nolabel="1"/>
            </form>
        </field>
    </record>

    <record id="picking_view_inherit_webship" model="ir.ui.view">
        <field name="name">picking.view.inherit.webship</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
             <xpath expr="//notebook" position="inside">
                <page string="Stoqflow" name="Webship" invisible="df_is_webship_source==False and df_is_webship_destination==False" >
                    <group string="Velden Stoqflow" name="Webshipgroup">
                        <field name="df_url_order"></field>
                        <field name="df_url_po"></field>
                        <field name="df_picking_lastsync_webship" readonly="1"></field>
                        <field name="df_picking_syncresult_webship"  readonly="1" widget="html"></field>
                        <field name="df_status_webship" readonly="1"></field>
                        <field name="df_last_changedate_webship" readonly="1"></field>
                        <field name="df_show_webship_page" invisible="1"></field>
                        <field name="df_is_webship_source" invisible="1"></field>
                        <field name="df_is_webship_destination" invisible="1"></field>
                        <p style="width:320px"><button icon="oi-arrow-right" name="ws_sync_picking" type="object" string="Manueel synchroniseren" class="btn-link"/></p>
                    </group>
                </page>
                <page string="Stoqflow Parcels" name="stoqflow_parcels" invisible="not df_show_parcels_tab or (df_is_webship_source==False and df_is_webship_destination==False)">
                    <field name="df_show_parcels_tab" invisible="1"/>
                    <field name="df_parcel_ids" readonly="1"/>
                </page>
                <page string="Pick Analysis" name="stoqflow_pick_analysis" invisible="not df_show_pick_analysis_tab or (df_is_webship_source==False and df_is_webship_destination==False)">
                    <field name="df_show_pick_analysis_tab" invisible="1"/>
                    <field name="df_pick_analysis_ids" readonly="1" nolabel="1">
                        <tree decoration-info="is_substitution" decoration-bf="is_total_line"
                              default_group_by="odoo_product_id">
                            <field name="is_total_line" column_invisible="1"/>
                            <field name="sequence" string="#"/>
                            <field name="ws_product_id" string="product_id"/>
                            <field name="ws_product_sku" string="SKU"/>
                            <field name="ws_product_name" string="Name"/>
                            <field name="ws_parent_product_id" string="parent_product_id"/>
                            <field name="ws_parent_product_sku" string="Parent SKU"/>
                            <field name="ws_parent_product_name" string="Parent Name"/>
                            <field name="odoo_product_id" string="Product in Odoo"/>
                            <field name="is_box" string="Box?"/>
                            <field name="packaging_id" string="Packaging"/>
                            <field name="packaging_qty" string="Qty/Box"/>
                            <field name="quantity" string="Qty Picked"/>
                            <field name="total_items" string="Total Items" sum="Total"/>
                            <field name="order_item_qty" string="Qty Ordered" optional="hide"/>
                            <field name="is_substitution" string="Subst." optional="hide"/>
                            <field name="ws_lookup_id" string="Lookup ID" optional="hide"/>
                        </tree>
                    </field>
                </page>
             </xpath>
        </field>
    </record>

    <record id="picking_view_inherit_webship_tracking_urls" model="ir.ui.view">
        <field name="name">picking.view.inherit.webship.tracking.urls</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock_delivery.view_picking_withcarrier_out_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='tracking']" position="after">
                <label for="df_carrier_tracking_urls"/>
                <div>
                    <field name="df_carrier_tracking_urls" class="oe_inline text-break" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
