<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--   PARTNER REPORT: Clients & Suppliers linked to Stoqflow      -->
    <!-- ============================================================ -->

    <!-- Tree View: Partners linked to Stoqflow -->
    <record id="stoqflow_partner_report_tree_view" model="ir.ui.view">
        <field name="name">stoqflow.partner.report.tree</field>
        <field name="model">res.partner</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <tree string="Stoqflow Clients &amp; Suppliers"
                  create="false"
                  edit="false"
                  default_order="write_date desc">

                <field name="name" string="Name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="city"/>
                <field name="country_id" string="Country"/>
                <field name="df_is_client_in_webship" string="Client"/>
                <field name="df_is_supplier_in_webship" string="Supplier"/>
                <field name="df_url_client" widget="html" string="Client in Stoqflow"/>
                <field name="df_url_supplier" widget="html" string="Supplier in Stoqflow"/>
                <field name="df_last_webship_sync" string="Last Sync"/>
                <field name="df_partner_syncresult_webship" widget="html" string="Sync Result"/>
            </tree>
        </field>
    </record>

    <!-- Search View: Filters for Stoqflow partner report -->
    <record id="stoqflow_partner_report_search_view" model="ir.ui.view">
        <field name="name">stoqflow.partner.report.search</field>
        <field name="model">res.partner</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <search string="Search Stoqflow Partners">
                <field name="name" string="Name"/>
                <field name="email"/>
                <field name="city"/>
                <field name="country_id" string="Country"/>
                <separator/>
                <filter string="Clients" name="clients"
                        domain="[('df_client_id_webship', '!=', False)]"/>
                <filter string="Suppliers" name="suppliers"
                        domain="[('df_supplier_id_webship', '!=', False)]"/>
                <separator/>
                <filter string="Synced" name="synced"
                        domain="[('df_partner_syncresult_webship', 'ilike', 'Success')]"/>
                <filter string="Sync Errors" name="sync_errors"
                        domain="[('df_partner_syncresult_webship', 'ilike', 'error')]"/>
                <filter string="Never Synced" name="never_synced"
                        domain="[('df_last_webship_sync', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Country" name="group_country"
                            context="{'group_by': 'country_id'}"/>
                    <filter string="City" name="group_city"
                            context="{'group_by': 'city'}"/>
                    <filter string="Last Sync (Month)" name="group_last_sync"
                            context="{'group_by': 'df_last_webship_sync:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Stoqflow Partners Report -->
    <record id="stoqflow_partner_report_action" model="ir.actions.act_window">
        <field name="name">Clients &amp; Suppliers in Stoqflow</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="stoqflow_partner_report_search_view"/>
        <field name="domain">
            [
                '|',
                    ('df_client_id_webship', '!=', False),
                    ('df_supplier_id_webship', '!=', False)
            ]
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No clients or suppliers linked to Stoqflow yet.
            </p>
            <p>
                Sync your partners with Stoqflow to see them listed here.
            </p>
        </field>
    </record>

    <!-- Explicit view binding so Odoo uses our custom tree, not the default -->
    <record id="stoqflow_partner_report_action_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="stoqflow_partner_report_tree_view"/>
        <field name="act_window_id" ref="stoqflow_partner_report_action"/>
    </record>

</odoo>
