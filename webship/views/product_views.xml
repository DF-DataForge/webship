<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Product Product Form View -->
    <record id="product_product_form_view_inherit_webship" model="ir.ui.view">
        <field name="name">product.product.form.inherit.webship</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Stoqflow" name="webship">
                    <group>
                        <field name="df_product_do_not_send_webship" string="Don't sync this product"/>
                    </group>

                    <separator string="Product Status" colspan="2"/>
                    <group>
                        <field name="df_url_prod" colspan="2" nolabel="1"/>
                        <field name="df_product_lastsync_webship" readonly="1" string="Last sync"/>
                    </group>

                    <group colspan="2">
                        <field name="df_product_syncresult_webship" readonly="1" widget="html" string="Sync Status"/>
                    </group>

                    <separator string="Stoqflow Product Details"/>
                    <group col="2">
                        <group string="General">
                            <field name="df_type"/>
                            <field name="df_brand_id"/>
                            <field name="df_stock_type"/>
                        </group>
                        <group string="Stock Levels">
                            <field name="df_min_stock"/>
                            <field name="df_max_stock"/>
                            <field name="df_min_order"/>
                            <field name="df_order_multiples"/>
                        </group>
                    </group>
                    <group col="2">
                        <group string="Dimensions">
                            <field name="df_length"/>
                            <field name="df_width"/>
                            <field name="df_height"/>
                        </group>
                        <group string="Trade &amp; Customs">
                            <field name="df_hs_code"/>
                            <field name="df_country_of_origin"/>
                            <field name="df_economic_operator"/>
                        </group>
                    </group>
                    <group col="2">
                        <group string="Flags">
                            <field name="df_stock_bio"/>
                            <field name="df_stock_foodstuff"/>
                            <field name="df_flag_cold_chain"/>
                            <field name="df_flag_fragile"/>
                            <field name="df_flag_hazardous"/>
                        </group>
                        <group string="Checks">
                            <field name="df_check_expiry_dates"/>
                            <field name="df_check_batches"/>
                            <field name="df_check_serial_numbers"/>
                        </group>
                    </group>

                    <separator string="Stoqflow Packagings"/>
                    <field name="ws_packaging_ids" nolabel="1" context="{'default_product_id': id}">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="qty"/>
                            <field name="df_sku_webship"/>
                            <field name="df_product_id_webship" optional="hide"/>
                            <button name="ws_match_packaging"
                                    type="object"
                                    icon="fa-refresh"
                                    title="Fetch Product ID from Stoqflow by SKU"
                                    class="btn-link"
                                    invisible="not df_sku_webship"/>
                        </list>
                    </field>

                    <separator string="Stoqflow Synchronization"/>
                    <group col="2">
                        <group>
                            <h5>🔗 Match Product</h5>
                            <p style="font-size: 12px; color: #666; margin-bottom: 12px;">
                                Search Stoqflow for a product matching this SKU and link it. Use when the product already exists in Stoqflow.
                            </p>
                            <button name="ws_match_product"
                                    type="object"
                                    string="Match with Stoqflow"
                                    class="btn btn-secondary"
                                    style="width: 100%; padding: 10px 16px; border-radius: 2px;"/>
                        </group>
                        <group>
                            <h5>➕ Create &amp; Sync</h5>
                            <p style="font-size: 12px; color: #666; margin-bottom: 12px;">
                                Push this product to Stoqflow. Creates new if SKU doesn't exist, or updates existing. If SKU already exists, use "Match" instead.
                            </p>
                            <button name="ws_sync_product"
                                    type="object"
                                    string="Sync with Stoqflow"
                                    class="btn btn-primary"
                                    style="width: 100%; padding: 10px 16px; border-radius: 2px;"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extend Product Template Form View -->
    <record id="product_template_form_view_inherit_webship" model="ir.ui.view">
        <field name="name">product.template.form.inherit.webship</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Stoqflow"
                      name="webship"
                      invisible="product_variant_count &gt; 1">
                    <separator string="Product Status"/>
                    <group>
                        <field name="df_url_prod" colspan="2" nolabel="1"/>
                    </group>

                    <separator string="Stoqflow Product Details"/>
                    <group col="2">
                        <group string="General">
                            <field name="df_type"/>
                            <field name="df_brand_id"/>
                            <field name="df_stock_type"/>
                        </group>
                        <group string="Stock Levels">
                            <field name="df_min_stock"/>
                            <field name="df_max_stock"/>
                            <field name="df_min_order"/>
                            <field name="df_order_multiples"/>
                        </group>
                    </group>
                    <group col="2">
                        <group string="Dimensions">
                            <field name="df_length"/>
                            <field name="df_width"/>
                            <field name="df_height"/>
                        </group>
                        <group string="Trade &amp; Customs">
                            <field name="df_hs_code"/>
                            <field name="df_country_of_origin"/>
                            <field name="df_economic_operator"/>
                        </group>
                    </group>
                    <group col="2">
                        <group string="Flags">
                            <field name="df_stock_bio"/>
                            <field name="df_stock_foodstuff"/>
                            <field name="df_flag_cold_chain"/>
                            <field name="df_flag_fragile"/>
                            <field name="df_flag_hazardous"/>
                        </group>
                        <group string="Checks">
                            <field name="df_check_expiry_dates"/>
                            <field name="df_check_batches"/>
                            <field name="df_check_serial_numbers"/>
                        </group>
                    </group>

                    <separator string="Stoqflow Packagings"/>
                    <field name="ws_packaging_ids" nolabel="1" context="{'default_product_id': product_variant_id}">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="qty"/>
                            <field name="df_sku_webship"/>
                            <field name="df_product_id_webship" optional="hide"/>
                            <button name="ws_match_packaging"
                                    type="object"
                                    icon="fa-refresh"
                                    title="Fetch Product ID from Stoqflow by SKU"
                                    class="btn-link"
                                    invisible="not df_sku_webship"/>
                        </list>
                    </field>

                    <separator string="Stoqflow Synchronization"/>
                    <group col="2">
                        <group>
                            <h5>🔗 Match Product</h5>
                            <p style="font-size: 12px; color: #666; margin-bottom: 12px;">
                                Search Stoqflow for a product matching this SKU and link it. Use when the product already exists in Stoqflow.
                            </p>
                            <button name="ws_match_product"
                                    type="object"
                                    string="Match with Stoqflow"
                                    class="btn btn-secondary"
                                    style="width: 100%; padding: 10px 16px; border-radius: 2px;"/>
                        </group>
                        <group>
                            <h5>➕ Create &amp; Sync</h5>
                            <p style="font-size: 12px; color: #666; margin-bottom: 12px;">
                                Push this product to Stoqflow. Creates new if SKU doesn't exist, or updates existing. If SKU already exists, use "Match" instead.
                            </p>
                            <button name="ws_sync_product"
                                    type="object"
                                    string="Sync with Stoqflow"
                                    class="btn btn-primary"
                                    style="width: 100%; padding: 10px 16px; border-radius: 2px;"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extend Product Variant Tree View -->
    <record id="product_product_tree_view_inherit_webship" model="ir.ui.view">
        <field name="name">product.product.tree.view.inherit.webship</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">

            <!-- Add header with buttons -->
            <xpath expr="//list" position="inside">
                <header>
                    <button name="ws_sync_product"
                            type="object"
                            string="Syncen met Stoqflow"
                            class="oe_highlight"/>
                    <button name="ws_match_product"
                            type="object"
                            string="Producten matchen met Stoqflow"
                            class="oe_highlight"/>
                </header>
            </xpath>

            <!-- Allow inline editing -->
            <xpath expr="//list" position="attributes">
                <attribute name="editable">bottom</attribute>
            </xpath>

            <!-- Add extra fields -->
            <xpath expr="//list" position="inside">
                <field name="df_url_prod" widget="html" optional="hide"/>
                <field name="df_product_lastsync_webship" readonly="1" optional="hide"/>
                <field name="df_product_syncresult_webship" readonly="1" widget="html" optional="hide"/>
            </xpath>

        </field>
    </record>

</odoo>