<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Stoqflow Stock Quant Tree View                             -->
    <!-- ========================================================= -->
    <record id="df_webship_stock_quant_tree_view" model="ir.ui.view">
        <field name="name">df.webship.stock.quant.tree</field>
        <field name="model">stock.quant</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">

            <tree string="Stoqflow Stock"
                  create="false"
                  edit="false"
                  default_order="product_id">

                <!-- Header button (multi-select) -->
                <header>
                    <button name="action_apply_webship_stock"
                            type="object"
                            string="Apply Stoqflow Stock to Odoo"
                            class="btn-primary"/>
                </header>

                <!-- Product & Location -->
                <field name="product_id"/>
                <field name="location_id" optional="hide"/>

                <!-- Odoo stock -->
                <field name="quantity"/>
                <field name="reserved_quantity"/>
                <field name="available_quantity"/>

                <!-- Stoqflow stock (API filled) -->
                <field name="df_webship_totalstock" optional="show"/>
                <field name="df_webship_reserved" optional="show"/>
                <field name="df_webship_available_stock" optional="show"/>

                <!-- Stoqflow sync info -->
                <field name="df_last_check_webship" optional="show"/>

                <field name="company_id" optional="hide"/>

            </tree>

        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Stoqflow Stock Action                                      -->
    <!-- ========================================================= -->
    <record id="webship_stock_action" model="ir.actions.act_window">
        <field name="name">Stoqflow Stock</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="df_webship_stock_quant_tree_view"/>
        <field name="domain">
            [
                ('location_id.df_is_webship_location', '=', True),
                ('location_id.usage', '=', 'internal')
            ]
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Stoqflow Stock Menu                                        -->
    <!-- ========================================================= -->
    <menuitem
        id="webship_stock_menu"
        name="Stock"
        parent="webship_root_menu"
        action="webship_stock_action"
        sequence="2"/>

</odoo>